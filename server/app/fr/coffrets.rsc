,"path","6wjy6b",{"d":"M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7"}],["$","path","1ihvrl",{"d":"M7.5 8a2.5 2.5 0 0 1 0-5A4.8 8 0 0 1 12 8a4.8 8 0 0 1 4.5-5 2.5 2.5 0 0 1 0 5"}],"$undefined"]}],["$","span",null,{"children":"Nos coffrets prêts à offrir"}]]}],["$","h1",null,{"className":"text-3xl sm:text-4xl md:text-5xl font-serif font-bold mb-4 text-balance","children":"Coffrets cadeaux gourmands"}],["$","p",null,{"className":"text-sm sm:text-base text-suzanne-creme/85 font-light leading-relaxed","children":"Nos coffrets sont préparés à la main dans notre boîte verte, avec du papier de soie et un ruban. Vous pouvez glisser un petit mot : on l'écrit pour vous."}]]}],["$","div",null,{"className":"relative w-48 h-48 sm:w-60 sm:h-60 rounded-brand overflow-hidden shadow-md flex-shrink-0 border border-suzanne-turquoise/30","children":["$","$La",null,{"src":"/images/produits/braj-coffret-vert.jpg","alt":"Coffret cadeau gourmand Cheffe Suzanne","fill":true,"priority":true,"className":"object-cover"}]}]]}],["$","div",null,{"className":"space-y-6","children":[["$","div",null,{"children":["$","h2",null,{"className":"text-2xl sm:text-3xl font-serif font-bold text-suzanne mb-2","children":"Nos coffrets prêts à offrir"}]}],["$","div",null,{"className":"grid grid-cols-1 md:grid-cols-3 gap-6","children":[["$","$Lb","coffret-decouverte",{"product":{"id":"coffret-decouverte","slug":{"fr":"coffret-decouverte","en":"discovery-box"},"name":{"fr":"Coffret Découverte","en":"Discovery box","ar":"علبة الاكتشاف"},"range":"coffrets","shortDescription":{"fr":"2 confitures + 1 boîte de biscuits. Pour un premier cadeau, ou pour faire goûter la maison.","en":"2 jams + 1 tin of biscuits. For a first gift or to share a taste of the kitchen.","ar":"مربيان + علبة بسكويت. كهدية أولى أو لتذوق منتجاتنا."},"description":{"fr":"Nos coffrets sont préparés à la main dans notre boîte verte, avec du papier de soie et un ruban. Vous pouvez glisser un petit mot : on l'écrit pour vous. Ce coffret contient 2 pots de confitures artisanales de saison et 1 boîte de nos sablés au beurre dorés.","en":"Our boxes are put together by hand in our green box, with tissue paper and a ribbon. Add a short note and we'll write it for you. Includes 2 jars of seasonal artisan jam and 1 tin of golden butter shortbreads.","ar":"نحضّر علبنا يدويًا في علبتنا الخضراء، بورق حريري وشريط. أضيفوا كلمة قصيرة ونكتبها لكم. تحتوي على برطمانين من مربى الموسم وعلبة بسكويت بالزبدة."},"ingredients":{"fr":"Voir le détail sur chaque produit composant le coffret.","en":"See individual product listings for ingredients.","ar":"انظر تفاصيل كل منتج داخل العلبة."},"storage":{"fr":"À conserver dans un endroit frais et sec.","en":"Store in a cool, dry place.","ar":"يُحفظ في مكان بارد وجاف."},"allergens":["gluten","lait","œufs"],"weight":"[Coffret 3 pièces]","price":0,"currency":"DZD","image":"/images/produits/braj-coffret-vert.jpg","badges":[],"inStock":true,"featured":false}}],["$","$Lb","coffret-du-gouter",{"product":{"id":"coffret-du-gouter","slug":{"fr":"coffret-du-gouter","en":"teatime-box"},"name":{"fr":"Coffret du Goûter","en":"Teatime box","ar":"علبة القهوة"},"range":"coffrets","shortDescription":{"fr":"1 braj, 1 confiture, 1 boîte de sablés. Le coffret qu'on emporte quand on est invité.","en":"1 braj, 1 jam, 1 tin of shortbread. The box you bring when invited.","ar":"براج، مربى، وعلبة بسكويت بالزبدة. العلبة المثالية عند الزيارة."},"description":{"fr":"Le coffret gourmand pour accompagner le café ou le thé de l'après-midi : une part généreuse de braj aux dattes tout frais, un pot de confiture de saison et une boîte de nos sablés traditionnels.","en":"The teatime box: freshly baked date braj, seasonal fruit jam, and a tin of traditional butter shortbread.","ar":"علبة شاي بعد الظهر: براج طازج بالتمر، مربى فواكه الموسم، وعلبة بسكويت بالزبدة."},"ingredients":{"fr":"Voir le détail sur chaque produit composant le coffret.","en":"See individual product listings for ingredients.","ar":"انظر تفاصيل كل منتج داخل العلبة."},"storage":{"fr":"Consommer le braj sous [5 jours].","en":"Consume braj within [5 days].","ar":"يُستهلك البراج خلال [5 أيام]."},"allergens":["gluten","lait","œufs"],"weight":"[Coffret 3 pièces]","price":0,"currency":"DZD","image":"/images/produits/braj-coffret-vert.jpg","badges":["Fait maison"],"inStock":true,"featured":false}}],["$","$Lb","coffret-de-la-table",{"product":{"id":"coffret-de-la-table","slug":{"fr":"coffret-de-la-table","en":"kitchen-box"},"name":{"fr":"Coffret de la Table","en":"Kitchen box","ar":"علبة المائدة"},"range":"coffrets","shortDescription":{"fr":"1 torchi, 1 citrons confits, 1 confiture, 1 boîte de biscuits. Pour ceux qui aiment cuisiner.","en":"1 torchi, 1 preserved lemons, 1 jam, 1 tin of biscuits. For those who love to cook.","ar":"طرشي، ليمون مصيّر، مربى، وعلبة بسكويت. لعشاق الطبخ."},"description":{"fr":"L'assortiment complet mêlant le salé et le sucré : nos légumes croquants en torchi, des citrons confits pour parfumer les plats mijotés, une confiture fruitée et des biscuits pour la touche sucrée.","en":"A complete mix of sweet and savoury: crunchy pickled torchi, preserved lemons for rich tagines, fruit jam, and butter biscuits.","ar":"تشكيلة متكاملة تجمع الحلو والمالح: طرشي الخضر المقرمشة، ليمون مصيّر للأطباق، مربى فاخر، وبسكويت شهي."},"ingredients":{"fr":"Voir le détail sur chaque produit composant le coffret.","en":"See individual product listings for ingredients.","ar":"انظر تفاصيل كل منتج داخل العلبة."},"storage":{"fr":"À conserver dans un endroit frais et sec.","en":"Store in a cool, dry place.","ar":"يُحفظ في مكان بارد وجاف."},"allergens":["gluten","lait","œufs"],"weight":"[Coffret 4 pièces]","price":0,"currency":"DZD","image":"/images/produits/braj-coffret-vert.jpg","badges":[],"inStock":true,"featured":false}}]]}]]}],["$","div",null,{"id":"composer","children":["$","$Lc",null,{"availableProducts":[{"id":"confiture-de-figues","slug":{"fr":"confiture-de-figues","en":"fig-jam"},"name":{"fr":"Confiture de figues","en":"Fig jam","ar":"مربى التين"},"range":"confitures","shortDescription":{"fr":"Des figues mûres cuites doucement, avec une pointe de citron.","en":"Ripe figs cooked slowly with a little lemon.","ar":"تين ناضج مطهو على نار هادئة مع قليل من الليمون."},"description":{"fr":"On attend que les figues soient bien mûres avant de les cuire, pour qu'elles donnent leur sucre naturel. Le résultat est une confiture épaisse, avec des morceaux, qui va aussi bien sur le pain que sur un fromage.","en":"We wait for the figs to be fully ripe so they bring their own sweetness. Thick, with pieces of fruit, good on bread or with cheese.","ar":"ننتظر أن ينضج التين تمامًا ليمنح حلاوته الطبيعية. مربى كثيف بقطع الفاكهة، يناسب الخبز والجبن."},"ingredients":{"fr":"Figues, sucre, jus de citron. [à confirmer]","en":"Figs, sugar, lemon juice. [to confirm]","ar":"تين، سكر، عصير ليمون. [يُؤكد لاحقًا]"},"storage":{"fr":"Avant ouverture, à l'abri de la lumière. Après ouverture, au réfrigérateur, à consommer sous 3 semaines.","en":"Before opening, keep away from light. After opening, refrigerate and eat within 3 weeks.","ar":"قبل الفتح، بعيدًا عن الضوء. بعد الفتح، في الثلاجة ويُستهلك خلال 3 أسابيع."},"allergens":[],"weight":"[250 g]","price":0,"currency":"DZD","image":"/images/bannieres/banniere-confitures.jpg","badges":["Sans conservateur"],"inStock":true,"featured":true},{"id":"confiture-d-abricots","slug":{"fr":"confiture-d-abricots","en":"apricot-jam"},"name":{"fr":"Confiture d'abricots","en":"Apricot jam","ar":"مربى المشمش"},"range":"confitures","shortDescription":{"fr":"Abricots en morceaux, légèrement acidulée.","en":"Apricot pieces, slightly tart.","ar":"قطع مشمش، بحموضة خفيفة."},"description":{"fr":"Une confiture qui garde le côté acidulé de l'abricot. On la cuit rapidement pour que les morceaux restent entiers.","en":"Cooked quickly so the pieces stay whole.","ar":"نطهوه بسرعة لتبقى القطع كاملة."},"ingredients":{"fr":"Abricots, sucre, jus de citron. [à confirmer]","en":"Apricots, sugar, lemon juice. [to confirm]","ar":"مشمش، سكر، عصير ليمون. [يُؤكد لاحقًا]"},"storage":{"fr":"Avant ouverture, à l'abri de la lumière. Après ouverture, au réfrigérateur, à consommer sous 3 semaines.","en":"Before opening, keep away from light. After opening, refrigerate and eat within 3 weeks.","ar":"قبل الفتح، بعيدًا عن الضوء. بعد الفتح، في الثلاجة ويُستهلك خلال 3 أسابيع."},"allergens":[],"weight":"[250 g]","price":0,"currency":"DZD","image":"/images/produits/confitures-biscuits.jpg","badges":["Sans conservateur","Fait maison"],"inStock":true,"featured":false},{"id":"confiture-d-oranges-ameres","slug":{"fr":"confiture-d-oranges-ameres","en":"bitter-orange-marmalade"},"name":{"fr":"Confiture d'oranges amères","en":"Bitter orange marmalade","ar":"مربى البرتقال المرّ"},"range":"confitures","shortDescription":{"fr":"Une confiture d'agrumes avec une belle amertume.","en":"A citrus jam with a pleasant bitterness.","ar":"مربى حمضيات بمرارة لطيفة."},"description":{"fr":"Préparée en hiver avec des oranges amères coupées à la main. Pour ceux qui aiment les confitures moins sucrées.","en":"Made in winter with hand-cut bitter oranges, for those who like their jam less sweet.","ar":"يُحضّر في الشتاء من برتقال مرّ مقطّع باليد، لمن يحب المربى الأقل حلاوة."},"ingredients":{"fr":"Oranges amères, sucre. [à confirmer]","en":"Bitter oranges, sugar. [to confirm]","ar":"برتقال مرّ، سكر. [يُؤكد لاحقًا]"},"storage":{"fr":"Avant ouverture, à l'abri de la lumière. Après ouverture, au réfrigérateur, à consommer sous 3 semaines.","en":"Before opening, keep away from light. After opening, refrigerate and eat within 3 weeks.","ar":"قبل الفتح، بعيدًا عن الضوء. بعد الفتح، في الثلاجة ويُستهلك خلال 3 أسابيع."},"allergens":[],"weight":"[250 g]","price":0,"currency":"DZD","image":"/images/bannieres/banniere-confitures.jpg","badges":["Sans conservateur"],"inStock":true,"featured":false},{"id":"sables-au-beurre","slug":{"fr":"sables-au-beurre","en":"butter-shortbread"},"name":{"fr":"Sablés au beurre","en":"Butter shortbread","ar":"بسكويت بالزبدة"},"range":"biscuits","shortDescription":{"fr":"Le sablé tout simple, au beurre, bien doré.","en":"Plain, buttery and golden.","ar":"بسيط، بالزبدة، ومذهّب."},"description":{"fr":"Une pâte au beurre, un peu de sucre, une cuisson lente. C'est le biscuit qu'on sert avec le café à la boutique.","en":"The biscuit we serve with coffee at the shop.","ar":"البسكويت الذي نقدّمه مع القهوة في المحل."},"ingredients":{"fr":"Farine, beurre, sucre, œufs, sel. Contient : gluten, lait, œufs.","en":"Flour, butter, sugar, eggs, salt. Contains: gluten, milk, eggs.","ar":"فرينة، زبدة، سكر، بيض، ملح. يحتوي على: غلوتين، حليب، بيض."},"storage":{"fr":"Dans sa boîte fermée, [3 semaines].","en":"In its sealed tin, [3 weeks].","ar":"في علبته المغلقة، [3 أسابيع]."},"allergens":["gluten","lait","œufs"],"weight":"[200 g]","price":0,"currency":"DZD","image":"/images/produits/confitures-biscuits.jpg","badges":["Fait maison"],"inStock":true,"featured":true},{"id":"biscuits-aux-amandes","slug":{"fr":"biscuits-aux-amandes","en":"almond-biscuits"},"name":{"fr":"Biscuits aux amandes","en":"Almond biscuits","ar":"بسكويت باللوز"},"range":"biscuits","shortDescription":{"fr":"Croquants, avec des amandes grillées.","en":"Crunchy, with roasted almonds.","ar":"مقرمش، بلوز محمّص."},"description":{"fr":"Des biscuits secs aux amandes torréfiées à l'atelier, parfaits à tremper dans le thé.","en":"Roasted in our kitchen, perfect for dipping in tea.","ar":"نحمّص اللوز في مطبخنا، مثالي مع الشاي."},"ingredients":{"fr":"Farine, amandes, sucre, beurre, œufs. Contient : gluten, fruits à coque, lait, œufs.","en":"Flour, almonds, sugar, butter, eggs. Contains: gluten, nuts, milk, eggs.","ar":"فرينة، لوز، سكر، زبدة، بيض. يحتوي على: غلوتين، مكسرات، حليب، بيض."},"storage":{"fr":"Dans sa boîte fermée, [3 semaines].","en":"In its sealed tin, [3 weeks].","ar":"في علبته المغلقة، [3 أسابيع]."},"allergens":["gluten","fruits à coque","lait","œufs"],"weight":"[200 g]","price":0,"currency":"DZD","image":"/images/produits/confitures-biscuits.jpg","badges":["Fait maison"],"inStock":true,"featured":false},{"id":"chlita-de-la-cheffe","slug":{"fr":"chlita-de-la-cheffe","en":"cheffes-chlita"},"name":{"fr":"Chlita de la Cheffe","en":"Cheffe's chlita","ar":"شليطة الشاف"},"range":"chlita","shortDescription":{"fr":"[Description courte à fournir par la marque : 1 phrase sur ce qu'est la chlita de la maison.]","en":"[Short description to be provided by the brand.]","ar":"[وصف قصير يقدّمه صاحب العلامة.]"},"description":{"fr":"[Texte à fournir par la marque : origine de la recette, ingrédients principaux, comment on la mange.]","en":"[Text to be provided by the brand: recipe origin, main ingredients, how it is enjoyed.]","ar":"[نص يقدّمه صاحب العلامة: أصل الوصفة، المكونات الرئيسية، طريقة التناول.]"},"ingredients":{"fr":"[Ingrédients à fournir]","en":"[Ingredients to be provided]","ar":"[المكونات تُحدد لاحقًا]"},"storage":{"fr":"Au frais après ouverture, couverte d'huile d'olive. [à confirmer]","en":"Refrigerate after opening, covered with olive oil. [to confirm]","ar":"في الثلاجة بعد الفتح، مغطاة بزيت الزيتون. [يُؤكد لاحقًا]"},"allergens":[],"weight":"[—]","price":0,"currency":"DZD","image":"/images/atelier/atelier-pains-bocaux.jpg","badges":["Fait maison"],"inStock":true,"featured":false},{"id":"braj-aux-dattes","slug":{"fr":"braj-aux-dattes","en":"date-braj"},"name":{"fr":"Braj aux dattes","en":"Date braj","ar":"براج بالتمر"},"range":"braj","shortDescription":{"fr":"Galette de semoule fourrée à la pâte de dattes.","en":"Semolina flatbread filled with date paste.","ar":"رقاقة سميد محشوة بعجينة التمر."},"description":{"fr":"Une pâte de semoule au beurre, une couche épaisse de dattes, une cuisson lente jusqu'à ce que les bords dorent. Se coupe en losanges et se partage au goûter, avec un lait ou un thé.","en":"Butter semolina dough, a thick layer of dates, slow-cooked until the edges turn golden. Cut into diamonds and shared at teatime.","ar":"عجينة سميد بالزبدة، طبقة سميكة من التمر، وطهي هادئ حتى تذهب الحواف. يُقطّع معيّنات ويُقتسم في وقت القهوة."},"ingredients":{"fr":"Semoule de blé, pâte de dattes, beurre, sel, [épices]. Contient : gluten, lait.","en":"Wheat semolina, date paste, butter, salt, [spices]. Contains: gluten, milk.","ar":"سميد قمح، عجينة تمر، زبدة، ملح، [توابل]. يحتوي على: غلوتين، حليب."},"storage":{"fr":"[5 jours] à température ambiante, dans un linge ou une boîte.","en":"[5 days] at room temperature, well wrapped.","ar":"[5 أيام] في درجة حرارة الغرفة، ملفوفًا جيدًا."},"allergens":["gluten","lait"],"weight":"[—]","price":0,"currency":"DZD","image":"/images/produits/braj-coffret-vert.jpg","badges":["Fait maison"],"inStock":true,"featured":true},{"id":"torchi-de-legumes","slug":{"fr":"torchi-de-legumes","en":"vegetable-torchi"},"name":{"fr":"Torchi de légumes","en":"Vegetable torchi","ar":"طرشي الخضر"},"range":"torchi","shortDescription":{"fr":"Carottes, navets et piments au vinaigre, bien croquants.","en":"Carrots, turnips and chillies in vinegar, nice and crunchy.","ar":"جزر ولفت وفلفل في الخل، مقرمش."},"description":{"fr":"Des légumes coupés à la main et conservés dans un vinaigre aux épices. Comptez [une semaine] de repos avant qu'ils prennent tout leur goût : on les met en vente quand ils sont prêts.","en":"Hand-cut vegetables in spiced vinegar. They rest for [a week] before they're ready to sell.","ar":"خضر مقطعة باليد في خل متبّل، تُترك [أسبوعًا] قبل أن تصبح جاهزة للبيع."},"ingredients":{"fr":"Carottes, navets, piments, vinaigre, eau, sel, ail, épices. [à confirmer]","en":"Carrots, turnips, chillies, vinegar, water, salt, garlic, spices. [to confirm]","ar":"جزر، لفت، فلفل حار، خل، ماء، ملح، ثوم، توابل. [يُؤكد لاحقًا]"},"storage":{"fr":"Au réfrigérateur après ouverture, légumes toujours couverts de liquide.","en":"Refrigerate after opening, vegetables always kept under brine.","ar":"في الثلاجة بعد الفتح، الخضر مغطاة دائمًا بالسائل."},"allergens":[],"weight":"[500 g]","price":0,"currency":"DZD","image":"/images/bannieres/banniere-pickles.jpg","badges":["Fait maison","Sans conservateur"],"inStock":true,"featured":true},{"id":"citrons-confits","slug":{"fr":"citrons-confits","en":"preserved-lemons"},"name":{"fr":"Citrons confits","en":"Preserved lemons","ar":"ليمون مصيّر"},"range":"torchi","shortDescription":{"fr":"Citrons confits au sel, pour les tajines et les salades.","en":"Salt-preserved lemons for tagines and salads.","ar":"ليمون محفوظ في الملح للطواجن والسلطات."},"description":{"fr":"Des citrons entiers confits dans le sel pendant [plusieurs semaines]. On utilise surtout l'écorce, coupée fin, dans les plats mijotés.","en":"Mostly the rind is used, finely chopped, in slow-cooked dishes.","ar":"يُستعمل القشر خاصة، مقطعًا رقيقًا، في الأطباق المطهوة ببطء."},"ingredients":{"fr":"Citrons, sel.","en":"Lemons, salt.","ar":"ليمون، ملح."},"storage":{"fr":"Au frais après ouverture, citrons immergés dans leur saumure.","en":"Keep cool after opening, submerged in brine.","ar":"في مكان بارد بعد الفتح، مغمورًا في ماء الملح."},"allergens":[],"weight":"[—]","price":0,"currency":"DZD","image":"/images/bannieres/banniere-pickles.jpg","badges":["Fait maison"],"inStock":true,"featured":false}]}]}],["$","div",null,{"className":"bg-stone-50 border border-suzanne/15 rounded-brand p-8 sm:p-12 flex flex-col lg:flex-row items-center justify-between gap-8 shadow-sm","children":[["$","div",null,{"className":"max-w-2xl space-y-4","children":[["$","div",null,{"className":"inline-flex items-center gap-2 text-suzanne text-xs font-bold uppercase tracking-wider","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-building2 w-4 h-4 text-suzanne-vertVif","children":[["$","path","1b4qmf",{"d":"M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"}],["$","path","i71pzd",{"d":"M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"}],["$","path","10jefs",{"d":"M18 9h2