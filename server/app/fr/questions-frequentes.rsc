8:["$","$Ld",null,{"locale":"fr","now":"$D2026-10-01T14:42:02.655Z","timeZone":"Europe/Paris","messages":{"common":{"topBanner":"Livraison à Oran sous [24–48 h] · Retrait gratuit à la boutique","byCheffe":"par la Cheffe","giftBoxesBadge":"Coffrets cadeaux","price":"Prix","priceUpcoming":"Prix à venir","fullAddress":"Hai Abdelkader, Traversa, Oran 31002, Algérie","badges":{"Fait maison":"Fait maison","Sans conservateur":"Sans conservateur"},"ranges":{"confitures":"Confitures","biscuits":"Biscuits","chlita":"Chlita","braj":"Braj","torchi":"Torchi","coffrets":"Coffrets"},"alts":{"hero":"Intérieur de l'épicerie fine Cheffe Suzanne à Oran, pain et huile d'olive sur le comptoir","cheffe":"Portrait de Cheffe Suzanne dans son atelier à Oran","giftBox":"Coffret cadeau gourmand Cheffe Suzanne en boîte verte","shopFacade":"Façade de l'épicerie fine Cheffe Suzanne à Oran","atelier1":"Dressage soigné à l'atelier Cheffe Suzanne","atelier2":"Mains de la Cheffe au travail sur une planche en bois","atelier3":"Sélection d'épices et aromates naturels","atelier4":"Flacons et condiments fins Cheffe Suzanne","atelier5":"Préparations, pains et bocaux artisanaux à Oran","confitures":"Confitures artisanales en pot avec tartine et cuillère","biscuits":"Biscuits faits maison, sablés et gourmandises","chlita":"Chlita traditionnelle et pains cuits à l'atelier","braj":"Braj aux dattes coupé en losanges dans son coffret vert","torchi":"Bocaux de torchi et légumes croquants au vinaigre"},"nav":{"home":"Accueil","products":"Nos produits","boxes":"Coffrets","story":"Notre histoire","shop":"La boutique","contact":"Contact","cart":"Panier"},"buttons":{"addToCart":"Ajouter au panier","viewProduct":"Voir le produit","orderWhatsApp":"Commander sur WhatsApp","buildBox":"Composer un coffret","visitUs":"Nous rendre visite","directions":"Voir l'itinéraire","readStory":"Lire notre histoire","seeBoxes":"Voir les coffrets","discoverProducts":"Découvrir nos produits","viewAllProducts":"Tout voir","callShop":"Appeler la boutique","send":"Envoyer","notifyMe":"Me prévenir","requestQuote":"Demander un devis","backHome":"Retour à l'accueil"},"footer":{"tagline":"« Des saveurs authentiques, une passion artisanale. »","brandDesc":"Cheffe Suzanne — épicerie fine et atelier à Oran.","subDesc":"Confitures, biscuits, chlita, braj et torchi préparés en petites quantités.","address":"Hai Abdelkader, Traversa, Oran","phone":"05 52 58 20 47","email":"shop@cheffesuzanne.com","hoursLabel":"Horaires :","hours":"[du samedi au jeudi, 9h – 19h]","infoLabel":"Informations","socialLabel":"Réseaux :","deliveryLink":"Livraison et retrait","faqLink":"Questions fréquentes","legalLink":"Mentions légales","copyright":"© 2026 Cheffe Suzanne"},"newsletter":{"title":"Une lettre par mois, pas plus.","text":"Les nouvelles confitures de saison, les dates de fabrication du braj et une recette de temps en temps.","placeholder":"Votre adresse email","button":"M'inscrire","success":"C'est noté. Le prochain courrier arrive au début du mois."}},"home":{"hero":{"eyebrow":"« Des saveurs authentiques, une passion artisanale. »","title":"Épicerie fine et fait maison, à Oran","subtitle":"Confitures de fruits de saison, biscuits, chlita, braj et torchi, préparés dans notre atelier en petites quantités."},"univers":{"title":"Ce qu'on prépare à l'atelier","jamsTitle":"Confitures","jamsDesc":"Des fruits de saison, du sucre, et le temps qu'il faut. Rien d'autre.","biscuitsTitle":"Biscuits","biscuitsDesc":"Des sablés et des petits gâteaux au beurre, pour le café ou pour recevoir.","chlitaTitle":"Chlita","chlitaDesc":"[Description courte à fournir par la marque : 1 phrase sur ce qu'est la chlita de la maison.]","brajTitle":"Braj","brajDesc":"La galette de semoule fourrée aux dattes, cuite comme à la maison.","torchiTitle":"Torchi","torchiDesc":"Légumes croquants au vinaigre, en bocaux préparés à la main."},"cheffe":{"title":"Derrière chaque bocal, il y a une cuisine","textP1":"Cheffe Suzanne, c'est d'abord une cuisine de famille. Les recettes viennent de [ma mère / ma grand-mère], et elles n'ont presque pas changé : on choisit les fruits au marché, on fait cuire, on remplit les bocaux, on colle l'étiquette à la main.","textP2":"Aujourd'hui, la cuisine est devenue un atelier et une petite épicerie à Oran. On y vend ce qu'on prépare, et quelques produits de producteurs qu'on connaît.","signature":"Suzanne"},"bestSellers":{"title":"Ce que nos clients reprennent","subtitle":"Les produits qui partent le plus vite à la boutique."},"values":{"title":"Comment on travaille","val1Title":"Des ingrédients qu'on peut nommer","val1Desc":"Fruits, sucre, semoule, dattes, beurre, vinaigre, épices. Pas de conservateurs, pas d'arômes ajoutés.","val2Title":"Des petites séries","val2Desc":"On cuisine par fournées de [quelques dizaines] de bocaux. La date de fabrication est écrite sur chaque étiquette.","val3Title":"Des fournisseurs proches","val3Desc":"On achète nos fruits et légumes auprès de producteurs de la région d'Oran dès que la saison le permet."},"giftBox":{"title":"Un cadeau qui se partage","text":"Pour un Aïd, une naissance, un merci ou un remerciement d'entreprise. Choisissez un coffret prêt à offrir ou composez le vôtre, on s'occupe du papier et du ruban."},"atelier":{"title":"Dans l'atelier cette semaine","subtitle":"Ce qui cuit, ce qui sèche, ce qui sort du four. Suivez-nous sur Instagram."},"reviews":{"title":"Ils en parlent mieux que nous"},"visit":{"title":"Passez à la boutique","text":"Vous pouvez goûter avant d'acheter. On vous fera aussi un coffret sur place si vous avez un cadeau à faire.","address":"Hai Abdelkader, Traversa, Oran · [Horaires]","hoursLabel":"Horaires :","hours":"[Samedi – Jeudi : 9h – 19h · Vendredi : fermé]"}},"cart":{"title":"Votre Panier","empty":"Votre panier est vide. Jetez un œil à nos confitures de saison.","subtotal":"Sous-total","shipping":"Livraison","shippingNote":"calculée à l'étape suivante","total":"Total","deliveryMode":"Mode de réception :","pickupOption":"Retrait à la boutique (gratuit)","deliveryOption":"Livraison à domicile","whatsappButton":"Envoyer ma commande sur WhatsApp","emailButton":"Envoyer par email","formName":"Nom complet","formPhone":"Numéro de téléphone","formAddress":"Adresse de livraison (si livraison)","formNotes":"Notes ou message cadeau (facultatif)","orderSuccess":"Merci ! Votre commande est partie sur WhatsApp. On vous confirme la disponibilité et l'heure de retrait ou de livraison.","soldOut":"Épuisé pour le moment","priceUpcoming":"Prix à venir","close":"Fermer","quantity":"Quantité","checkout":"Commander","itemAdded":"Produit ajouté au panier"},"products":{"h1":"Nos produits faits maison","intro":"Tout ce que vous voyez ici est préparé dans notre atelier à Oran, en petites séries. Les stocks bougent avec les saisons : si un produit est épuisé, écrivez-nous, on vous prévient quand il revient.","filterAll":"Tout","filterConfitures":"Confitures","filterBiscuits":"Biscuits","filterChlita":"Chlita","filterBraj":"Braj","filterTorchi":"Torchi","filterCoffrets":"Coffrets","sortBy":"Trier par","sortDefault":"Par défaut","sortPriceAsc":"Prix croissant","sortPriceDesc":"Prix décroissant","soldOut":"Épuisé pour le moment","notifyMe":"Me prévenir","noProducts":"Aucun produit ne correspond à vos critères.","categoryIntros":{"confitures":{"title":"Confitures artisanales","text":"Nos confitures suivent les saisons : figues en fin d'été, oranges amères en hiver, abricots au printemps. On les cuit en petites marmites pour garder le goût du fruit et une texture qui tient sur la tartine. Sans conservateurs ni colorants."},"biscuits":{"title":"Biscuits faits maison","text":"Des recettes au beurre, simples et bien dorées. Ils se conservent [deux à trois semaines] dans leur boîte et se prêtent aussi bien au thé de l'après-midi qu'à un plateau pour recevoir."},"chlita":{"title":"Chlita traditionnelle","text":"[Texte à fournir par la marque : origine de la recette, ingrédients principaux, comment on la mange.]"},"braj":{"title":"Braj","text":"Le braj est une galette de semoule fourrée à la pâte de dattes, cuite à la poêle ou au tadjine. Chez nous, on le prépare comme à la maison : semoule, beurre, dattes, une pointe d'épices. On le fait toute l'année, et un peu plus quand arrive le printemps."},"torchi":{"title":"Torchi (pickles maison)","text":"Carottes, navets, piments, citrons : des légumes croquants conservés dans un vinaigre aromatisé. Le torchi accompagne les plats en sauce, les sandwichs et les grillades."},"coffrets":{"title":"Coffrets cadeaux","text":"Nos coffrets sont préparés à la main dans notre boîte verte, avec du papier de soie et un ruban. Vous pouvez glisser un petit mot : on l'écrit pour vous."}}},"productDetail":{"tabs":{"description":"Description","ingredients":"Ingrédients","storage":"Conservation"},"allergensTitle":"Allergènes :","allergensWarning":"Contient :","relatedTitle":"Vous aimerez aussi","breadcrumbs":{"home":"Accueil","products":"Nos produits"},"weight":"Poids :","quantity":"Quantité","addToCart":"Ajouter au panier","priceUpcoming":"Prix à venir","inStock":"En stock","outOfStock":"Épuisé pour le moment","notifyWhatsApp":"Me prévenir sur WhatsApp"},"boxesPage":{"h1":"Coffrets cadeaux gourmands","intro":"Nos coffrets sont préparés à la main dans notre boîte verte, avec du papier de soie et un ruban. Vous pouvez glisser un petit mot : on l'écrit pour vous.","readyMadeTitle":"Nos coffrets prêts à offrir","customBoxTitle":"Composer mon coffret","customBoxSubtitle":"Choisissez 3 à 6 produits, on assemble le coffret pour vous.","selectedCount":"{count} / 6 produits sélectionnés (minimum 3)","addCustomBoxToCart":"Ajouter mon coffret au panier","minProductsWarning":"Veuillez sélectionner au moins 3 produits pour composer votre coffret.","maxProductsWarning":"Vous pouvez choisir au maximum 6 produits.","corporateTitle":"Pour vos clients, vos équipes, vos invités","corporateText":"Mariages, fiançailles, Aïd, fin d'année : on prépare des coffrets en série, avec une carte à votre nom. Prévoyez [10 jours] de délai pour plus de 20 coffrets.","corporateButton":"Demander un devis sur WhatsApp"},"storyPage":{"h1":"Notre histoire","p1":"Tout a commencé dans une cuisine familiale, à Oran. [Ma mère] faisait ses confitures chaque été, le braj quand venait le printemps, et le torchi en grands bocaux qu'on gardait sur le balcon. Je l'ai regardée faire pendant des années avant d'oser toucher à la marmite.","p2":"En [année], j'ai commencé à vendre quelques bocaux à des voisins, puis à des amis d'amis. Les commandes ont grandi, la cuisine est devenue trop petite. En [année], Cheffe Suzanne a ouvert sa boutique, avec un atelier juste derrière.","p3":"On travaille toujours de la même façon : on achète ce qui est de saison, on cuisine en petites quantités, et on ne met rien dans un bocal qu'on ne servirait pas à notre propre table. À côté de nos préparations, vous trouverez aussi des produits choisis chez des producteurs qu'on connaît personnellement : huiles, miels, épices.","p4":"Si vous passez à la boutique, il y a souvent quelque chose qui cuit. N'hésitez pas à demander à goûter.","signature":"Suzanne","stats":"[X] recettes · [X] bocaux par semaine · [X] producteurs partenaires"},"shopPage":{"h1":"Notre épicerie fine à Oran","text":"La boutique est à Hai Abdelkader, Traversa. Vous y trouverez toutes nos préparations, des produits d'épicerie fine sélectionnés, et des coffrets prêts à offrir. On prend le temps de vous faire goûter et de vous conseiller.","addressTitle":"Adresse","address":"Hai Abdelkader, Traversa, Oran 31002","hoursTitle":"Horaires","hours":"[Samedi – Jeudi : 9h – 19h · Vendredi : fermé]","accessTitle":"Accès et repères","access":"[Repère proche, stationnement…]","directions":"Voir l'itinéraire","call":"Appeler la boutique"},"contactPage":{"h1":"Contact et commandes","text":"Une question sur un produit, une commande pour un événement, une allergie ? Écrivez-nous ou appelez, on répond [dans la journée].","formName":"Nom","formPhone":"Téléphone","formEmail":"Email (facultatif)","formMessage":"Votre message","formSubmit":"Envoyer","formSuccess":"Merci, votre message est bien arrivé. On vous répond [dans la journée].","whatsappTitle":"Le plus rapide :","whatsappText":"Écrivez-nous sur WhatsApp au 05 52 58 20 47."},"deliveryPage":{"h1":"Livraison et retrait","pickupTitle":"Retrait en boutique","pickupText":"Gratuit. Votre commande est prête [en 2 heures] pendant les horaires d'ouverture. On vous envoie un message quand elle vous attend.","oranTitle":"Livraison à Oran","oranText":"[— DA], sous [24 à 48 h].","wilayasTitle":"Livraison dans les autres wilayas","wilayasText":"[Disponible / pas encore disponible]. [Délais et tarifs].","paymentTitle":"Paiement","paymentText":"À la livraison ou en boutique, en espèces [ou par carte].","freshTitle":"Produits frais","freshText":"Le braj se conserve quelques jours : on le prépare à la commande et on le livre uniquement à Oran."},"faqPage":{"h1":"Questions fréquentes","items":"$e"},"legalNoticePage":{"h1":"Mentions légales","text":"[À rédiger avec les informations légales de l'entreprise : raison sociale, NIF / RC, adresse, responsable de publication, hébergeur.]"},"journalPage":{"h1":"Le Journal de la Cheffe","emptyState":"Les premiers articles de notre carnet de cuisine arrivent très bientôt. Au programme : recettes familiales, coulisses de l'atelier et astuces de conservation."}},"children":["$","$L16",null,{"children":["$L17",["$","$L18",null,{}],["$","main",null,{"className":"flex-1","children":["$","$L3",null,{"parallelRouterKey":"children","segmentPath":["children","$4","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L5",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":["$","$L19",null,{}],"notFoundStyles":[]}]}],"$L1a",["$","$L1b",null,{}]]}]}]
