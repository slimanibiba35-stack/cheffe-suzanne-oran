n",null,{"className":"text-suzanne-turquoise font-medium","aria-current":"page","children":"الطرشي"}]]}],["$","h1",null,{"className":"text-3xl sm:text-4xl md:text-5xl font-serif font-bold text-suzanne-creme text-balance","children":"الطرشي"}]]}]]}],["$","div",null,{"className":"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 sm:pt-10","children":[["$","div",null,{"className":"bg-white rounded-brand border border-suzanne/10 p-6 sm:p-8 mb-10 shadow-sm max-w-4xl","children":[["$","h2",null,{"className":"text-xl font-serif font-bold text-suzanne mb-3","children":"الطرشي"}],["$","p",null,{"className":"text-sm sm:text-base text-suzanne/85 leading-relaxed font-light","children":"جزر، لفت، فلفل حار، ليمون: خضر مقرمشة محفوظة في خل متبّل. يرافق الأطباق بالمرق، والسندويتشات والمشويات."}]]}],["$","$Lc",null,{"products":[{"id":"confiture-de-figues","slug":{"fr":"confiture-de-figues","en":"fig-jam"},"name":{"fr":"Confiture de figues","en":"Fig jam","ar":"مربى التين"},"range":"confitures","shortDescription":{"fr":"Des figues mûres cuites doucement, avec une pointe de citron.","en":"Ripe figs cooked slowly with a little lemon.","ar":"تين ناضج مطهو على نار هادئة مع قليل من الليمون."},"description":{"fr":"On attend que les figues soient bien mûres avant de les cuire, pour qu'elles donnent leur sucre naturel. Le résultat est une confiture épaisse, avec des morceaux, qui va aussi bien sur le pain que sur un fromage.","en":"We wait for the figs to be fully ripe so they bring their own sweetness. Thick, with pieces of fruit, good on bread or with cheese.","ar":"ننتظر أن ينضج التين تمامًا ليمنح حلاوته الطبيعية. مربى كثيف بقطع الفاكهة، يناسب الخبز والجبن."},"ingredients":{"fr":"Figues, sucre, jus de citron. [à confirmer]","en":"Figs, sugar, lemon juice. [to confirm]","ar":"تين، سكر، عصير ليمون. [يُؤكد لاحقًا]"},"storage":{"fr":"Avant ouverture, à l'abri de la lumière. Après ouverture, au réfrigérateur, à consommer sous 3 semaines.","en":"Before opening, keep away from light. After opening, refrigerate and eat within 3 weeks.","ar":"قبل الفتح، بعيدًا عن الضوء. بعد الفتح، في الثلاجة ويُستهلك خلال 3 أسابيع."},"allergens":[],"weight":"[250 g]","price":0,"currency":"DZD","image":"/images/bannieres/banniere-confitures.jpg","badges":["Sans conservateur"],"inStock":true,"featured":true},{"id":"confiture-d-abricots","slug":{"fr":"confiture-d-abricots","en":"apricot-jam"},"name":{"fr":"Confiture d'abricots","en":"Apricot jam","ar":"مربى المشمش"},"range":"confitures","shortDescription":{"fr":"Abricots en morceaux, légèrement acidulée.","en":"Apricot pieces, slightly tart.","ar":"قطع مشمش، بحموضة خفيفة."},"description":{"fr":"Une confiture qui garde le côté acidulé de l'abricot. On la cuit rapidement pour que les morceaux restent entiers.","en":"Cooked quickly so the pieces stay whole.","ar":"نطهوه بسرعة لتبقى القطع كاملة."},"ingredients":{"fr":"Abricots, sucre, jus de citron. [à confirmer]","en":"Apricots, sugar, lemon juice. [to confirm]","ar":"مشمش، سكر، عصير ليمون. [يُؤكد لاحقًا]"},"storage":{"fr":"Avant ouverture, à l'abri de la lumière. Après ouverture, au réfrigérateur, à consommer sous 3 semaines.","en":"Before opening, keep away from light. After opening, refrigerate and eat within 3 weeks.","ar":"قبل الفتح، بعيدًا عن الضوء. بعد الفتح، في الثلاجة ويُستهلك خلال 3 أسابيع."},"allergens":[],"weight":"[250 g]","price":0,"currency":"DZD","image":"/images/produits/confitures-biscuits.jpg","badges":["Sans conservateur","Fait maison"],"inStock":true,"featured":false},{"id":"confiture-d-oranges-ameres","slug":{"fr":"confiture-d-oranges-ameres","en":"bitter-orange-marmalade"},"name":{"fr":"Confiture d'oranges amères","en":"Bitter orange marmalade","ar":"مربى البرتقال المرّ"},"range":"confitures","shortDescription":{"fr":"Une confiture d'agrumes avec une belle amertume.","en":"A citrus jam with a pleasant bitterness.","ar":"مربى حمضيات بمرارة لطيفة."},"description":{"fr":"Préparée en hiver avec des oranges amères coupées à la main. Pour ceux qui aiment les confitures moins sucrées.","en":"Made in winter with hand-cut bitter oranges, for those who like their jam less sweet.","ar":"يُحضّر في الشتاء من برتقال مرّ مقطّع باليد، لمن يحب المربى الأقل حلاوة."},"ingredients":{"fr":"Oranges amères, sucre. [à confirmer]","en":"Bitter oranges, sugar. [to confirm]","ar":"برتقال مرّ، سكر. [يُؤكد لاحقًا]"},"storage":{"fr":"Avant ouverture, à l'abri de la lumière. Après ouverture, au réfrigérateur, à consommer sous 3 semaines.","en":"Before opening, keep away from light. After opening, refrigerate and eat within 3 weeks.","ar":"قبل الفتح، بعيدًا عن الضوء. بعد الفتح، في الثلاجة ويُستهلك خلال 3 أسابيع."},"allergens":[],"weight":"[250 g]","price":0,"currency":"DZD","image":"/images/bannieres/banniere-confitures.jpg","badges":["Sans conservateur"],"inStock":true,"featured":false},{"id":"sables-au-beurre","slug":{"fr":"sables-au-beurre","en":"butter-shortbread"},"name":{"fr":"Sablés au beurre","en":"Butter shortbread","ar":"بسكويت بالزبدة"},"range":"biscuits","shortDescription":{"fr":"Le sablé tout simple, au beurre, bien doré.","en":"Plain, buttery and golden.","ar":"بسيط، بالزبدة، ومذهّب."},"description":{"fr":"Une pâte au beurre, un peu de sucre, une cuisson lente. C'est le biscuit qu'on sert avec le café à la boutique.","en":"The biscuit we serve with coffee at the shop.","ar":"البسكويت الذي نقدّمه مع القهوة في المحل."},"ingredients":{"fr":"Farine, beurre, sucre, œufs, sel. Contient : gluten, lait, œufs.","en":"Flour, butter, sugar, eggs, salt. Contains: gluten, milk, eggs.","ar":"فرينة، زبدة، سكر، بيض، ملح. يحتوي على: غلوتين، حليب، بيض."},"storage":{"fr":"Dans sa boîte fermée, [3 semaines].","en":"In its sealed tin, [3 weeks].","ar":"في علبته المغلقة، [3 أسابيع]."},"allergens":["gluten","lait","œufs"],"weight":"[200 g]","price":0,"currency":"DZD","image":"/images/produits/confitures-biscuits.jpg","badges":["Fait maison"],"inStock":true,"featured":true},{"id":"biscuits-aux-amandes","slug":{"fr":"biscuits-aux-amandes","en":"almond-biscuits"},"name":{"fr":"Biscuits aux amandes","en":"Almond biscuits","ar":"بسكويت باللوز"},"range":"biscuits","shortDescription":{"fr":"Croquants, avec des amandes grillées.","en":"Crunchy, with roasted almonds.","ar":"مقرمش، بلوز محمّص."},"description":{"fr":"Des biscuits secs aux amandes torréfiées à l'atelier, parfaits à tremper dans le thé.","en":"Roasted in our kitchen, perfect for dipping in tea.","ar":"نحمّص اللوز في مطبخنا، مثالي مع الشاي."},"ingredients":{"fr":"Farine, amandes, sucre, beurre, œufs. Contient : gluten, fruits à coque, lait, œufs.","en":"Flour, almonds, sugar, butter, eggs. Contains: gluten, nuts, milk, eggs.","ar":"فرينة، لوز، سكر، زبدة، بيض. يحتوي على: غلوتين، مكسرات، حليب، بيض."},"storage":{"fr":"Dans sa boîte fermée, [3 semaines].","en":"In its sealed tin, [3 weeks].","ar":"في علبته المغلقة، [3 أسابيع]."},"allergens":["gluten","fruits à coque","lait","œufs"],"weight":"[200 g]","price":0,"currency":"DZD","image":"/images/produits/confitures-biscuits.jpg","badges":["Fait maison"],"inStock":true,"featured":false},{"id":"chlita-de-la-cheffe","slug":{"fr":"chlita-de-la-cheffe","en":"cheffes-chlita"},"name":{"fr":"Chlita de la Cheffe","en":"Cheffe's chlita","ar":"شليطة الشاف"},"range":"chlita","shortDescription":{"fr":"[Description courte à fournir par la marque : 1 phrase sur ce qu'est la chlita de la maison.]","en":"[Short description to be provided by the brand.]","ar":"[وصف قصير يقدّمه صاحب العلامة.]"},"description":{"fr":"[Texte à fournir par la marque : origine de la recette, ingrédients principaux, comment on la mange.]","en":"[Text to be provided by the brand: recipe origin, main ingredients, how it is enjoyed.]","ar":"[نص يقدّمه صاحب العلامة: أصل الوصفة، المكونات الرئيسية، طريقة التناول.]"},"ingredients":{"fr":"[Ingrédients à fournir]","en":"[Ingredients to be provided]","ar":"[المكونات تُحدد لاحقًا]"},"storage":{"fr":"Au frais après ouverture, couverte d'huile d'olive. [à confirmer]","en":"Refrigerate after opening, covered with olive oil. [to confirm]","ar":"في الثلاجة بعد الفتح، مغطاة بزيت الزيتون. [يُؤكد لاحقًا]"},"allergens":[],"weight":"[—]","price":0,"currency":"DZD","image":"/images/atelier/atelier-pains-bocaux.jpg","badges":["Fait maison"],"inStock":true,"featured":false},{"id":"braj-aux-dattes","slug":{"fr":"braj-aux-dattes","en":"date-braj"},"name":{"fr":"Braj aux dattes","en":"Date braj","ar":"براج بالتمر"},"range":"braj","shortDescription":{"fr":"Galette de semoule fourrée à la pâte de dattes.","en":"Semolina flatbread filled with date paste.","ar":"رقاقة سميد محشوة بعجينة التمر."},"description":{"fr":"Une pâte de semoule au beurre, une couche épaisse de dattes, une cuisson lente jusqu'à ce que les bords dorent. Se coupe en losanges et se partage au goûter, avec un lait ou un thé.","en":"Butter semolina dough, a thick layer of dates, slow-cooked until the edges turn golden. Cut into diamonds and shared at teatime.","ar":"عجينة سميد بالزبدة، طبقة سميكة من التمر، وطهي هادئ حتى تذهب الحواف. يُقطّع معيّنات ويُقتسم في وقت القهوة."},"ingredients":{"fr":"Semoule de blé, pâte de dattes, beurre, sel, [épices]. Contient : gluten, lait.","en":"Wheat semolina, date paste, butter, salt, [spices]. Contains: gluten, milk.","ar":"سميد قمح، عجينة تمر، زبدة، ملح، [توابل]. يحتوي على: غلوتين، حليب."},"storage":{"fr":"[5 jours] à température ambiante, dans un linge ou une boîte.","en":"[5 days] at room temperature, well wrapped.","ar":"[5 أيام] في درجة حرارة الغرفة، ملفوفًا جيدًا."},"allergens":["gluten","lait"],"weight":"[—]","price":0,"currency":"DZD","image":"/images/produits/braj-coffret-vert.jpg","badges":["Fait maison"],"inStock":true,"featured":true},{"id":"torchi-de-legumes","slug":{"fr":"torchi-de-legumes","en":"vegetable-torchi"},"name":{"fr":"Torchi de légumes","en":"Vegetable torchi","ar":"طرشي الخضر"},"range":"torchi","shortDescription":{"fr":"Carottes, navets et piments au vinaigre, bien croquants.","en":"Carrots, turnips and chillies in vinegar, nice and crunchy.","ar":"جزر ولفت وفلفل في الخل، مقرمش."},"description":{"fr":"Des légumes coupés à la main et conservés dans un vinaigre aux épices. Comptez [une semaine] de repos avant qu'ils prennent tout leur goût : on les met en vente quand ils sont prêts.","en":"Hand-cut vegetables in spiced vinegar. They rest for [a week] before they're ready to sell.","ar":"خضر مقطعة باليد في خل متبّل، تُترك [أسبوعًا] قبل أن تصبح جاهزة للبيع."},"ingredients":{"fr":"Carottes, navets, piments, vinaigre, eau, sel, ail, épices. [à confirmer]","en":"Carrots, turnips, chillies, vinegar, water, salt, garlic, spices. [to confirm]","ar":"جزر، لفت، فلفل حار، خل، ماء، ملح، ثوم، توابل. [يُؤكد لاحقًا]"},"storage":{"fr":"Au réfrigérateur après ouverture, légumes toujours couverts de liquide.","en":"Refrigerate after opening, vegetables always kept under brine.","ar":"في الثلاجة بعد الفتح، الخضر مغطاة دائمًا بالسائل."},"allergens":[],"weight":"[500 g]","price":0,"currency":"DZD","image":"/images/bannieres/banniere-pickles.jpg","badges":["Fait maison","Sans conservateur"],"inStock":true,"featured":true},{"id":"citrons-confits","slug":{"fr":"citrons-confits","en":"preserved-lemons"},"name":{"fr":"Citrons confits","en":"Preserved lemons","ar":"ليمون مصيّر"},"range":"torchi","shortDescription":{"fr":"Citrons confits au sel, pour les tajines et les salades.","en":"Salt-preserved lemons for tagines and salads.","ar":"ليمون محفوظ في الملح للطواجن والسلطات."},"description":{"fr":"Des citrons entiers confits dans le sel pendant [plusieurs semaines]. On utilise surtout l'écorce, coupée fin, dans les plats mijotés.","en":"Mostly the rind is used, finely chopped, in slow-cooked dishes.","ar":"يُستعمل القشر خاصة، مقطعًا رقيقًا، في الأطباق المطهوة ببطء."},"ingredients":{"fr":"Citrons, sel.","en":"Lemons, salt.","ar":"ليمون، ملح."},"storage":{"fr":"Au frais après ouverture, citrons immergés dans leur saumure.","en":"Keep cool after opening, submerged in brine.","ar":"في مكان بارد بعد الفتح، مغمورًا في ماء الملح."},"allergens":[],"weight":"[—]","price":0,"currency":"DZD","image":"/images/bannieres/banniere-pickles.jpg","badges":["Fait maison"],"inStock":true,"featured":false},{"id":"coffret-decouverte","slug":{"fr":"coffret-decouverte","en":"discovery-box"},"name":{"fr":"Coffret Découverte","en":"Discovery box","ar":"علبة الاكتشاف"},"range":"coffrets","shortDescription":{"fr":"2 confitures + 1 boîte de biscuits. Pour un premier cadeau, ou pour faire goûter la maison.","en":"2 jams + 1 tin of biscuits. For a first gift or to share a taste of the kitchen.","ar":"مربيان + علبة بسكويت. كهدية أولى أو لتذوق منتجاتنا."},"description":{"fr":"Nos coffrets sont préparés à la main dans notre boîte verte, avec du papier de soie et un ruban. Vous pouvez glisser un petit mot : on l'écrit pour vous. Ce coffret contient 2 pots de confitures artisanales de saison et 1 boîte de nos sablés au beurre dorés.","en":"Our boxes are put together by hand in our green box, with tissue paper and a ribbon. Add a short note and we'll write it for you. Includes 2 jars of seasonal artisan jam and 1 tin of golden butter shortbreads.","ar":"نحضّر علبنا يدويًا في علبتنا الخضراء، بورق حريري وشريط. أضيفوا كلمة قصيرة ونكتبها لكم. تحتوي على برطمانين من مربى الموسم وعلبة بسكويت بالزبدة."},"ingredients":{"fr":"Voir le détail sur chaque produit composant le coffret.","en":"See individual product listings for ingredients.","ar":"انظر تفاصيل كل منتج داخل العلبة."},"storage":{"fr":"À conserver dans un endroit frais et sec.","en":"Store in a cool, dry place.","ar":"يُحفظ في مكان بارد وجاف."},"allergens":["gluten","lait","œufs"],"weight":"[Coffret 3 pièces]","price":0,"currency":"DZD","image":"/images/produits/braj-coffret-vert.jpg","badges":[],"inStock":true,"featured":false},{"id":"coffret-du-gouter","slug":{"fr":"coffret-du-gouter","en":"teatime-box"},"name":{"fr":"Coffret du Goûter","en":"Teatime box","ar":"علبة القهوة"},"range":"coffrets","shortDescription":{"fr":"1 braj, 1 confiture, 1 boîte de sablés. Le coffret qu'on emporte quand on est invité.","en":"1 braj, 1 jam, 1 tin of shortbread. The box you bring when invited.","ar":"براج، مربى، وعلبة بسكويت بالزبدة. العلبة المثالية عند الزيارة."},"description":{"fr":"Le coffret gourmand pour accompagner le café ou le thé de l'après-midi : une part généreuse de braj aux dattes tout frais, un pot de confiture de saison et une boîte de nos sablés traditionnels.","en":"The teatime box: freshly baked date braj, seasonal fruit jam, and a tin of traditional butter shortbread.","ar":"علبة شاي بعد الظهر: براج طازج بالتمر، مربى فواكه الموسم، وعلبة بسكويت بالزبدة."},"ingredients":{"fr":"Voir le détail sur chaque produit composant le coffret.","en":"See individual product listings for ingredients.","ar":"انظر تفاصيل كل منتج داخل العلبة."},"storage":{"fr":"Consommer le braj sous [5 jours].","en":"Consume braj within [5 days].","ar":"يُستهلك البراج خلال [5 أيام]."},"allergens":["gluten","lait","œufs"],"weight":"[Coffret 3 pièces]","price":0,"currency":"DZD","image":"/images/produits/braj-coffret-vert.jpg","badges":["Fait maison"],"inStock":true,"featured":false},{"id":"coffret-de-la-table","slug":{"fr":"coffret-de-la-table","en":"kitchen-box"},"name":{"fr":"Coffret de la Table","en":"Kitchen box","ar":"علبة المائدة"},"range":"coffrets","shortDescription":{"fr":"1 torchi, 1 citrons confits, 1 confiture, 1 boîte de biscuits. Pour ceux qui aiment cuisiner.","en":"1 torchi, 1 preserved lemons, 1 jam, 1 tin of biscuits. For those who love to cook.","ar":"طرشي، ليمون مصيّر، مربى، وعلبة بسكويت. لعشاق الطبخ."},"description":{"fr":"L'assortiment complet mêlant le salé et le sucré : nos légumes croquants en torchi, des citrons confits pour parfumer les plats mijotés, une confiture fruitée et des biscuits pour la touche sucrée.","en":"A complete mix of sweet and savoury: crunchy pickled torchi, preserved lemons for rich tagines, fruit jam, and butter biscuits.","ar":"تشكيلة متكاملة تجمع الحلو والمالح: طرشي الخضر المقرمشة، ليمون مصيّر للأطباق، مربى فاخر، وبسكويت شهي."},"ingredients":{"fr":"Voir le détail sur chaque produit composant le coffret.","en":"See individual product listings for ingredients.","ar":"انظر تفاصيل كل منتج داخل العلبة."},"storage":{"fr":"À conserver dans un endroit frais et sec.","en":"Store in a cool, dry place.","ar":"يُحفظ في مكان بارد وجاف."},"allergens":["gluten","lait","œufs"],"weight":"[Coffret 4 pièces]","price":0,"currency":"DZD","image":"/images/produits/braj-coffret-vert.jpg","badges":[],"inStock":true,"featured":false}],"initialCategory":"torchi"}],["$","div",null,{"className":"mt-16 bg-suzanne-vertVif/10 border border-suzanne-vertVif/20 rounded-brand p-6 sm:p-8 flex flex-col sm:flex-row items-center justify-between gap-6","children":[["$","div",null,{"className":"flex items-center gap-4","children":[["$","div",null,{"className":"p-3 bg-suzanne text-suzanne-creme rounded-full","children":["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-gift w-6 h-6 text-suzanne-vertVif","children":[["$","rect","bkv52",{"x":"3","y":"8","width":"18","height":"4","rx":"1"}],["$","path","1c76mn",{"d":"M12 8v13"}],["$","path","6wjy6b",{"d":"M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7"}],["$","path","1ihvrl",{"d":"M7.5 8a2.5 2.5 0 0 1 0-5A4.8 8 0 0 1 12 8a4.8 8 0 0 1 4.5-5 2.5 2.5 0 0 1 0 5"}],"$undefined"]}]}],["$","div",null,{"children":[["$","h3",null,{"className":"text-base sm:text-lg font-bold text-suzanne font-serif","children":"علب هدايا من منتجاتنا"}],["$","p",null,{"className":"text-xs sm:text-sm text-suzanne/75","children":"اختر من 3 إلى 6 منتجات، ونحن نجهّز العلبة لك."}]]}]]}],"$Ld"]}]]}]]}]
8:["$","$Le",null,{"locale":"ar","now":"$D2026-10-01T14:42:03.934Z","timeZone":"Europe/Paris","messages":{"common":{"topBanner":"توصيل داخل وهران خلال [24 إلى 48 ساعة] · الاستلام من المحل مجانًا","byCheffe":"من إعداد الشاف","giftBoxesBadge":"علب هدايا","price":"السعر","priceUpcoming":"السعر يُحدد لاحقًا","fullAddress":"حي عبد القادر، ترافيرسا، وهران 31002، الجزائر","badges":{"Fait maison":"صناعة منزلية","Sans conservateur":"بدون مواد حافظة"},"ranges":{"confitures":"المربى","biscuits":"البسكويت","chlita":"الشليطة","braj":"البراج","torchi":"الطرشي","coffrets":"علب الهدايا"},"alts":{"hero":"داخل محل الشاف سوزان للمنتجات الراقية في وهران، خبز وزيت زيتون على الطاولة","cheffe":"صورة الشاف سوزان في مطبخها بوهران","giftBox":"علبة هدايا الشاف سوزان في علبة خضراء","shopFacade":"واجهة محل الشاف سوزان للمنتجات الراقية في وهران","atelier1":"تقديم الأطباق في مطبخ الشاف سوزان","atelier2":"يدا الشاف أثناء العمل على لوح خشبي","atelier3":"تشكيلة من التوابل والأعشاب الطبيعية","atelier4":"قوارير ومطيبات راقية من الشاف سوزان","atelier5":"مخبوزات وبرطمانات تقليدية في وهران","confitures":"مربى تقليدي في برطمان مع شريحة خبز وملعقة","biscuits":"بسكويت منزلي، حلوى وحلويات بالزبدة","chlita":"شليطة تقليدية وخبز مطهو في المطبخ","braj":"براج بالتمر مقطع لمعينات في علبته الخضراء","torchi":"برطمانات طرشي وخضر مقرمشة في الخل"},"nav":{"home":"الرئيسية","products":"منتجاتنا","boxes":"علب الهدايا","story":"قصتنا","shop":"المحل","contact":"اتصل بنا","cart":"السلة"},"buttons":{"addToCart":"أضف إلى السلة","viewProduct":"عرض المنتج","orderWhatsApp":"اطلب عبر واتساب","buildBox":"كوّن علبتك","visitUs":"زورونا","directions":"الاتجاهات إلى المحل","readStory":"اقرأ قصتنا","seeBoxes":"عرض علب الهدايا","discoverProducts":"اكتشف منتجاتنا","viewAllProducts":"عرض الكل","callShop":"اتصل بالمحل","send":"إرسال","notifyMe":"أعلموني عند توفره","requestQuote":"اطلب عرض سعر","backHome":"العودة إلى الرئيسية"},"footer":{"tagline":"« نكهات أصيلة، شغف حرفي. »","brandDesc":"الشاف سوزان، محل منتجات راقية ومطبخ في وهران.","subDesc":"مربى، بسكويت، شليطة، براج وطرشي نحضّرها بكميات صغيرة.","address":"حي عبد القادر، ترافيرسا، وهران","phone":"05 52 58 20 47","email":"shop@cheffesuzanne.com","hoursLabel":"أوقات العمل:","hours":"[من السبت إلى الخميس، من 9 صباحًا إلى 7 مساءً]","infoLabel":"معلومات","socialLabel":"التواصل:","deliveryLink":"التوصيل والاستلام","faqLink":"الأسئلة الشائعة","legalLink":"إشعار قانوني","copyright":"© 2026 الشاف سوزان"},"newsletter":{"title":"رسالة واحدة في الشهر، لا أكثر.","text":"أنواع المربى الجديدة حسب الموسم، مواعيد تحضير البراج، ووصفة من حين لآخر.","placeholder":"بريدك الإلكتروني","button":"اشترك","success":"تم التسجيل. تصلك الرسالة القادمة في بداية الشهر."}},"home":{"hero":{"eyebrow":"« نكهات أصيلة، شغف حرفي. »","title":"منتجات راقية وصناعة منزلية في وهران","subtitle":"مربى من فواكه الموسم، بسكويت، شليطة، براج وطرشي، نحضّرها في مطبخنا بكميات صغيرة."},"univers":{"title":"ما نحضّره في المطبخ","jamsTitle":"المربى التقليدي","jamsDesc":"فواكه الموسم، سكر، والوقت اللازم. لا شيء آخر.","biscuitsTitle":"بسكويت البيت","biscuitsDesc":"بسكويت بالزبدة وحلويات صغيرة، مع القهوة أو لاستقبال الضيوف.","chlitaTitle":"الشليطة التقليدية","chlitaDesc":"[وصف قصير يقدّمه صاحب العلامة.]","brajTitle":"البراج","brajDesc":"رقاقة السميد المحشوة بعجينة التمر، مطهوّة كما في البيت.","torchiTitle":"الطرشي (مخللات منزلية)","torchiDesc":"خضر مقرمشة في الخل، نعبّئها يدويًا."},"cheffe":{"title":"وراء كل برطمان، مطبخ","textP1":"بدأت الشاف سوزان في مطبخ عائلي. الوصفات ورثناها عن [أمي / جدتي]، ولم تتغير تقريبًا: نختار الفواكه من السوق، نطهوها، نملأ البرطمانات ونلصق الملصقات بأيدينا.","textP2":"اليوم أصبح ذلك المطبخ ورشة صغيرة ومحلًّا في وهران، نبيع فيه ما نحضّره، وبعض منتجات فلاحين نعرفهم.","signature":"سوزان"},"bestSellers":{"title":"الأكثر طلبًا","subtitle":"ما يعود زبائننا لشرائه."},"values":{"title":"طريقة عملنا","val1Title":"مكونات معروفة","val1Desc":"فواكه، سكر، سميد، تمر، زبدة، خل، توابل. بدون مواد حافظة وبدون نكهات مضافة.","val2Title":"كميات صغيرة","val2Desc":"نحضّر [بضع عشرات] من البرطمانات في كل مرة، وتاريخ التحضير مكتوب على كل ملصق.","val3Title":"موردون قريبون","val3Desc":"نشتري الفواكه والخضر من فلاحي منطقة وهران كلما سمح الموسم."},"giftBox":{"title":"هدية تُقتسم","text":"للعيد، لمولود جديد، لكلمة شكر أو لهدايا الشركات. اختر علبة جاهزة أو كوّن علبتك، ونحن نتكفّل بالتغليف والشريط."},"atelier":{"title":"في مطبخنا هذا الأسبوع","subtitle":"ما يُطهى، وما يجفّ، وما يخرج من الفرن. تابعونا على إنستغرام."},"reviews":{"title":"زبائننا يتحدثون عنا"},"visit":{"title":"مرّوا على المحل","text":"يمكنكم التذوق قبل الشراء، وإن كانت لديكم هدية نحضّر لكم علبة في الحين.","address":"حي عبد القادر، ترافيرسا، وهران · [أوقات العمل]","hoursLabel":"أوقات العمل:","hours":"[من السبت إلى الخميس: من 9 صباحًا إلى 7 مساءً · الجمعة: مغلق]"}},"cart":{"title":"سلة المشتريات","empty":"سلتك فارغة. ألقِ نظرة على مربيات الموسم.","subtotal":"المجموع الفرعي","shipping":"التوصيل","shippingNote":"يُحسب في الخطوة التالية","total":"المجموع","deliveryMode":"طريقة الاستلام:","pickupOption":"الاستلام من المحل (مجانًا)","deliveryOption":"التوصيل إلى المنزل","whatsappButton":"أرسل طلبي عبر واتساب","emailButton":"إرسال عبر البريد الإلكتروني","formName":"الاسم الكامل","formPhone":"رقم الهاتف","formAddress":"عنوان التوصيل (في حال التوصيل)","formNotes":"ملاحظات أو رسالة هدية (اختياري)","orderSuccess":"شكرًا! أُرسل طلبك عبر واتساب. سنؤكد لك التوفر ووقت الاستلام أو التوصيل.","soldOut":"غير متوفر حاليًا","priceUpcoming":"السعر يُحدد لاحقًا","close":"إغلاق","quantity":"الكمية","checkout":"متابعة الطلب","itemAdded":"تمت إضافة المنتج إلى السلة"},"products":{"h1":"منتجاتنا المصنوعة في البيت","intro":"كل ما تجدونه هنا محضّر في مطبخنا بوهران، بكميات صغيرة. المخزون يتغير مع المواسم: إن نفد منتج، راسلونا ونخبركم عند عودته.","filterAll":"الكل","filterConfitures":"المربى","filterBiscuits":"البسكويت","filterChlita":"الشليطة","filterBraj":"البراج","filterTorchi":"الطرشي","filterCoffrets":"علب الهدايا","sortBy":"ترتيب حسب","sortDefault":"الافتراضي","sortPriceAsc":"السعر: من الأقل للأعلى","sortPriceDesc":"السعر: من الأعلى للأقل","soldOut":"غير متوفر حاليًا","notifyMe":"أعلموني عند توفره","noProducts":"لا توجد منتجات تطابق اختيارك.","categoryIntros":{"confitures":{"title":"مربى تقليدي","text":"نتبع المواسم في مربياتنا: التين في آخر الصيف، البرتقال المرّ في الشتاء، والمشمش في الربيع. نطهوها في قدور صغيرة لنحافظ على طعم الفاكهة وقوام يبقى على الخبز. بدون مواد حافظة ولا ملوّنات."},"biscuits":{"title":"بسكويت البيت","text":"وصفات بسيطة بالزبدة، مذهّبة جيدًا. يُحفظ [من أسبوعين إلى ثلاثة] في علبته."},"chlita":{"title":"الشليطة التقليدية","text":"[نص يقدّمه صاحب العلامة.]"},"braj":{"title":"البراج","text":"البراج رقاقة من السميد محشوة بعجينة التمر، تُطهى في المقلاة أو على الطاجين. نحضّره كما في البيت: سميد، زبدة، تمر، وقليل من التوابل. نصنعه طوال السنة، وأكثر قليلًا مع قدوم الربيع."},"torchi":{"title":"الطرشي","text":"جزر، لفت، فلفل حار، ليمون: خضر مقرمشة محفوظة في خل متبّل. يرافق الأطباق بالمرق، والسندويتشات والمشويات."},"coffrets":{"title":"علب الهدايا","text":"نحضّر علبنا يدويًا في علبتنا الخضراء، بورق حريري وشريط. أضيفوا كلمة قصيرة ونكتبها لكم."}}},"productDetail":{"tabs":{"description":"الوصف","ingredients":"المكونات","storage":"طريقة الحفظ"},"allergensTitle":"يحتوي على (مسببات الحساسية):","allergensWarning":"يحتوي على:","relatedTitle":"قد يعجبك أيضًا","breadcrumbs":{"home":"الرئيسية","products":"منتجاتنا"},"weight":"الوزن:","quantity":"الكمية","addToCart":"أضف إلى السلة","priceUpcoming":"السعر يُحدد لاحقًا","inStock":"متوفر","outOfStock":"غير متوفر حاليًا","notifyWhatsApp":"أعلموني عبر واتساب"},"boxesPage":{"h1":"علب هدايا من منتجاتنا","intro":"نحضّر علبنا يدويًا في علبتنا الخضراء، بورق حريري وشريط. أضيفوا كلمة قصيرة ونكتبها لكم.","readyMadeTitle":"علبنا الجاهزة للإهداء","customBoxTitle":"كوّن علبتك","customBoxSubtitle":"اختر من 3 إلى 6 منتجات، ونحن نجهّز العلبة لك.","selectedCount":"{count} / 6 منتجات مختارة (3 على الأقل)","addCustomBoxToCart":"أضف علبتي المخصصة إلى السلة","minProductsWarning":"يرجى اختيار 3 منتجات على الأقل لتكوين علبتك.","maxProductsWarning":"يمكنك اختيار 6 منتجات كحد أقصى.","corporateTitle":"لعملائكم وفرقكم وضيوفكم","corporateText":"أعراس، خطوبات، أعياد، نهاية السنة: نحضّر علبًا بالكمية مع بطاقة باسمكم. يُرجى الطلب قبل [10 أيام] لأكثر من 20 علبة.","corporateButton":"اطلب عرض سعر عبر واتساب"},"storyPage":{"h1":"قصتنا","p1":"بدأ كل شيء في مطبخ عائلي بوهران. كانت [أمي] تحضّر المربى كل صيف، والبراج مع قدوم الربيع، والطرشي في برطمانات كبيرة نحفظها في الشرفة. بقيت أراقبها سنوات قبل أن أجرؤ على لمس القدر.","p2":"في [السنة]، بدأت أبيع بعض البرطمانات للجيران، ثم لأصدقاء الأصدقاء. كثرت الطلبات وضاق المطبخ. وفي [السنة]، فتحت الشاف سوزان محلّها، وخلفه مطبخ.","p3":"ما زلنا نعمل بالطريقة نفسها: نشتري ما هو في موسمه، نطهو بكميات صغيرة، ولا نضع في برطمان ما لا نقدّمه على مائدتنا. وإلى جانب منتجاتنا، ستجدون منتجات اخترناها من فلاحين نعرفهم شخصيًا: زيوت، عسل، وتوابل.","p4":"إن مررتم على المحل، فغالبًا هناك شيء يُطهى. لا تترددوا في طلب التذوق.","signature":"سوزان","stats":"[X] وصفات · [X] برطمان أسبوعيًا · [X] فلاحين شركاء"},"shopPage":{"h1":"محل المنتجات الراقية في وهران","text":"يقع المحل في حي عبد القادر، ترافيرسا. ستجدون فيه كل منتجاتنا، ومنتجات راقية مختارة، وعلب هدايا جاهزة. نأخذ وقتنا لنجعلكم تتذوقون ونساعدكم في الاختيار.","addressTitle":"العنوان","address":"حي عبد القادر، ترافيرسا، وهران 31002","hoursTitle":"أوقات العمل","hours":"[السبت – الخميس: 9 صباحًا – 7 مساءً · الجمعة: مغلق]","accessTitle":"المعالم والوصول","access":"[معلم قريب، موقف سيارات…]","directions":"الاتجاهات إلى المحل","call":"الاتصال بالمحل"},"contactPage":{"h1":"الاتصال والطلبات","text":"سؤال عن منتج، طلب لمناسبة، حساسية من مكوّن؟ راسلونا أو اتصلوا بنا، نرد [في اليوم نفسه].","formName":"الاسم","formPhone":"الهاتف","formEmail":"البريد الإلكتروني (اختياري)","formMessage":"رسالتك","formSubmit":"إرسال","formSuccess":"شكرًا، وصلتنا رسالتك. سنرد عليك [في اليوم نفسه].","whatsappTitle":"الأسرع:","whatsappText":"راسلونا على واتساب 05 52 58 20 47."},"deliveryPage":{"h1":"التوصيل والاستلام","pickupTitle":"الاستلام من المحل","pickupText":"مجاني. يكون الطلب جاهزًا خلال [ساعتين] في أوقات العمل.","oranTitle":"التوصيل داخل وهران","oranText":"[— دج]، خلال [24 إلى 48 ساعة].","wilayasTitle":"الولايات الأخرى","wilayasText":"[يُؤكد لاحقًا].","paymentTitle":"الدفع","paymentText":"نقدًا عند الاستلام أو في المحل [أو بالبطاقة].","freshTitle":"المنتجات الطازجة","freshText":"البراج يُحفظ بضعة أيام، لذلك نحضّره حسب الطلب ونوصله داخل وهران فقط."},"faqPage":{"h1":"الأسئلة الشائعة","items":[{"q":"هل تحتوي مربياتكم على مواد حافظة؟","a":"لا. تحتوي على فواكه وسكر وأحيانًا عصير ليمون. السكر والطهي يكفيان لحفظها."},{"q":"كم يدوم المربى بعد الفتح؟","a":"حوالي ثلاثة أسابيع في الثلاجة، مع استعمال ملعقة نظيفة في كل مرة."},{"q":"كم يدوم البراج؟","a":"[5 أيام] في درجة حرارة الغرفة، ملفوفًا جيدًا. ويمكن تجميده وتسخينه في المقلاة."},{"q":"هل توصلون خارج وهران؟","a":"[يُؤكد لاحقًا]"},{"q":"هل يمكن الطلب لعرس أو مناسبة؟","a":"نعم. اتصلوا بنا قبل [10 أيام] على الأقل للكميات الكبيرة."},{"q":"هل منتجاتكم حلال؟","a":"[يُؤكد من طرف العلامة]"},{"q":"مسببات الحساسية؟","a":"البسكويت والبراج يحتويان على الغلوتين والحليب، وبعض أنواع البسكويت تحتوي على البيض والمكسرات. كل ذلك مذكور في صفحة كل منتج وعلى الملصق."}]},"legalNoticePage":{"h1":"إشعار قانوني","text":"[يُحرر بالمعلومات القانونية للشركة : السجل التجاري، المعرف الجبائي، العنوان، مسؤول النشر، المستضيف.]"},"journalPage":{"h1":"يوميات الشاف","emptyState":"المقالات الأولى من يوميات مطبخنا قادمة قريبًا جدًا: وصفات عائلية، كواليس الورشة، ونصائح الحفظ."}},"children":["$","$Lf",null,{"children":["$L10",["$","$L11",null,{}],["$","main",null,{"className":"flex-1","children":["$","$L3",null,{"parallelRouterKey":"children","segmentPath":["children","$4","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L5",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":["$","$L12",null,{}],"notFoundStyles":[]}]}],"$L13",["$","$L14",null,{}]]}]}]
