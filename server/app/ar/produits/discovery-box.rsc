0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-right w-3.5 h-3.5 rtl:rotate-180 text-suzanne/40","children":[["$","path","mthhwq",{"d":"m9 18 6-6-6-6"}],"$undefined"]}],"$Ld",["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-right w-3.5 h-3.5 rtl:rotate-180 text-suzanne/40","children":[["$","path","mthhwq",{"d":"m9 18 6-6-6-6"}],"$undefined"]}],["$","span",null,{"className":"text-suzanne font-semibold","aria-current":"page","children":"علبة الاكتشاف"}]]}],["$","div",null,{"className":"mb-16","children":["$","$Le",null,{"product":{"id":"coffret-decouverte","slug":{"fr":"coffret-decouverte","en":"discovery-box"},"name":{"fr":"Coffret Découverte","en":"Discovery box","ar":"علبة الاكتشاف"},"range":"coffrets","shortDescription":{"fr":"2 confitures + 1 boîte de biscuits. Pour un premier cadeau, ou pour faire goûter la maison.","en":"2 jams + 1 tin of biscuits. For a first gift or to share a taste of the kitchen.","ar":"مربيان + علبة بسكويت. كهدية أولى أو لتذوق منتجاتنا."},"description":{"fr":"Nos coffrets sont préparés à la main dans notre boîte verte, avec du papier de soie et un ruban. Vous pouvez glisser un petit mot : on l'écrit pour vous. Ce coffret contient 2 pots de confitures artisanales de saison et 1 boîte de nos sablés au beurre dorés.","en":"Our boxes are put together by hand in our green box, with tissue paper and a ribbon. Add a short note and we'll write it for you. Includes 2 jars of seasonal artisan jam and 1 tin of golden butter shortbreads.","ar":"نحضّر علبنا يدويًا في علبتنا الخضراء، بورق حريري وشريط. أضيفوا كلمة قصيرة ونكتبها لكم. تحتوي على برطمانين من مربى الموسم وعلبة بسكويت بالزبدة."},"ingredients":{"fr":"Voir le détail sur chaque produit composant le coffret.","en":"See individual product listings for ingredients.","ar":"انظر تفاصيل كل منتج داخل العلبة."},"storage":{"fr":"À conserver dans un endroit frais et sec.","en":"Store in a cool, dry place.","ar":"يُحفظ في مكان بارد وجاف."},"allergens":["gluten","lait","œufs"],"weight":"[Coffret 3 pièces]","price":0,"currency":"DZD","image":"/images/produits/braj-coffret-vert.jpg","badges":[],"inStock":true,"featured":false}}]}],["$","div",null,{"className":"pt-12 border-t border-suzanne/10","children":[["$","h2",null,{"className":"text-2xl sm:text-3xl font-serif font-bold text-suzanne mb-8","children":"قد يعجبك أيضًا"}],["$","div",null,{"className":"grid grid-cols-2 md:grid-cols-3 gap-4 sm:gap-6","children":[["$","$Lf","coffret-du-gouter",{"product":{"id":"coffret-du-gouter","slug":{"fr":"coffret-du-gouter","en":"teatime-box"},"name":{"fr":"Coffret du Goûter","en":"Teatime box","ar":"علبة القهوة"},"range":"coffrets","shortDescription":{"fr":"1 braj, 1 confiture, 1 boîte de sablés. Le coffret qu'on emporte quand on est invité.","en":"1 braj, 1 jam, 1 tin of shortbread. The box you bring when invited.","ar":"براج، مربى، وعلبة بسكويت بالزبدة. العلبة المثالية عند الزيارة."},"description":{"fr":"Le coffret gourmand pour accompagner le café ou le thé de l'après-midi : une part généreuse de braj aux dattes tout frais, un pot de confiture de saison et une boîte de nos sablés traditionnels.","en":"The teatime box: freshly baked date braj, seasonal fruit jam, and a tin of traditional butter shortbread.","ar":"علبة شاي بعد الظهر: براج طازج بالتمر، مربى فواكه الموسم، وعلبة بسكويت بالزبدة."},"ingredients":{"fr":"Voir le détail sur chaque produit composant le coffret.","en":"See individual product listings for ingredients.","ar":"انظر تفاصيل كل منتج داخل العلبة."},"storage":{"fr":"Consommer le braj sous [5 jours].","en":"Consume braj within [5 days].","ar":"يُستهلك البراج خلال [5 أيام]."},"allergens":["gluten","lait","œufs"],"weight":"[Coffret 3 pièces]","price":0,"currency":"DZD","image":"/images/produits/braj-coffret-vert.jpg","badges":["Fait maison"],"inStock":true,"featured":false}}],["$","$Lf","coffret-de-la-table",{"product":{"id":"coffret-de-la-table","slug":{"fr":"coffret-de-la-table","en":"kitchen-box"},"name":{"fr":"Coffret de la Table","en":"Kitchen box","ar":"علبة المائدة"},"range":"coffrets","shortDescription":{"fr":"1 torchi, 1 citrons confits, 1 confiture, 1 boîte de biscuits. Pour ceux qui aiment cuisiner.","en":"1 torchi, 1 preserved lemons, 1 jam, 1 tin of biscuits. For those who love to cook.","ar":"طرشي، ليمون مصيّر، مربى، وعلبة بسكويت. لعشاق الطبخ."},"description":{"fr":"L'assortiment complet mêlant le salé et le sucré : nos légumes croquants en torchi, des citrons confits pour parfumer les plats mijotés, une confiture fruitée et des biscuits pour la touche sucrée.","en":"A complete mix of sweet and savoury: crunchy pickled torchi, preserved lemons for rich tagines, fruit jam, and butter biscuits.","ar":"تشكيلة متكاملة تجمع الحلو والمالح: طرشي الخضر المقرمشة، ليمون مصيّر للأطباق، مربى فاخر، وبسكويت شهي."},"ingredients":{"fr":"Voir le détail sur chaque produit composant le coffret.","en":"See individual product listings for ingredients.","ar":"انظر تفاصيل كل منتج داخل العلبة."},"storage":{"fr":"À conserver dans un endroit frais et sec.","en":"Store in a cool, dry place.","ar":"يُحفظ في مكان بارد وجاف."},"allergens":["gluten","lait","œufs"],"weight":"[Coffret 4 pièces]","price":0,"currency":"DZD","image":"/images/produits/braj-coffret-vert.jpg","badges":[],"inStock":true,"featured":false}}],["$","$Lf","confiture-de-figues",{"product":{"id":"confiture-de-figues","slug":{"fr":"confiture-de-figues","en":"fig-jam"},"name":{"fr":"Confiture de figues","en":"Fig jam","ar":"مربى التين"},"range":"confitures","shortDescription":{"fr":"Des figues mûres cuites doucement, avec une pointe de citron.","en":"Ripe figs cooked slowly with a little lemon.","ar":"تين ناضج مطهو على نار هادئة مع قليل من الليمون."},"description":{"fr":"On attend que les figues soient bien mûres avant de les cuire, pour qu'elles donnent leur sucre naturel. Le résultat est une confiture épaisse, avec des morceaux, qui va aussi bien sur le pain que sur un fromage.","en":"We wait for the figs to be fully ripe so they bring their own sweetness. Thick, with pieces of fruit, good on bread or with cheese.","ar":"ننتظر أن ينضج التين تمامًا ليمنح حلاوته الطبيعية. مربى كثيف بقطع الفاكهة، يناسب الخبز والجبن."},"ingredients":{"fr":"Figues, sucre, jus de citron. [à confirmer]","en":"Figs, sugar, lemon juice. [to confirm]","ar":"تين، سكر، عصير ليمون. [يُؤكد لاحقًا]"},"storage":{"fr":"Avant ouverture, à l'abri de la lumière. Après ouverture, au réfrigérateur, à consommer sous 3 semaines.","en":"Before opening, keep away from light. After opening, refrigerate and eat within 3 weeks.","ar":"قبل الفتح، بعيدًا عن الضوء. بعد الفتح، في الثلاجة ويُستهلك خلال 3 أسابيع."},"allergens":[],"weight":"[250 g]","price":0,"currency":"DZD","image":"/images/bannieres/banniere-confitures.jpg","badges":["Sans conservateur"],"inStock":true,"featured":true}}]]}]]}]]}]]}]
