8:["$","$Lb",null,{"locale":"ar","now":"$D2026-10-01T14:41:58.709Z","timeZone":"Europe/Paris","messages":{"common":{"topBanner":"توصيل داخل وهران خلال [24 إلى 48 ساعة] · الاستلام من المحل مجانًا","byCheffe":"من إعداد الشاف","giftBoxesBadge":"علب هدايا","price":"السعر","priceUpcoming":"السعر يُحدد لاحقًا","fullAddress":"حي عبد القادر، ترافيرسا، وهران 31002، الجزائر","badges":{"Fait maison":"صناعة منزلية","Sans conservateur":"بدون مواد حافظة"},"ranges":{"confitures":"المربى","biscuits":"البسكويت","chlita":"الشليطة","braj":"البراج","torchi":"الطرشي","coffrets":"علب الهدايا"},"alts":{"hero":"داخل محل الشاف سوزان للمنتجات الراقية في وهران، خبز وزيت زيتون على الطاولة","cheffe":"صورة الشاف سوزان في مطبخها بوهران","giftBox":"علبة هدايا الشاف سوزان في علبة خضراء","shopFacade":"واجهة محل الشاف سوزان للمنتجات الراقية في وهران","atelier1":"تقديم الأطباق في مطبخ الشاف سوزان","atelier2":"يدا الشاف أثناء العمل على لوح خشبي","atelier3":"تشكيلة من التوابل والأعشاب الطبيعية","atelier4":"قوارير ومطيبات راقية من الشاف سوزان","atelier5":"مخبوزات وبرطمانات تقليدية في وهران","confitures":"مربى تقليدي في برطمان مع شريحة خبز وملعقة","biscuits":"بسكويت منزلي، حلوى وحلويات بالزبدة","chlita":"شليطة تقليدية وخبز مطهو في المطبخ","braj":"براج بالتمر مقطع لمعينات في علبته الخضراء","torchi":"برطمانات طرشي وخضر مقرمشة في الخل"},"nav":{"home":"الرئيسية","products":"منتجاتنا","boxes":"علب الهدايا","story":"قصتنا","shop":"المحل","contact":"اتصل بنا","cart":"السلة"},"buttons":{"addToCart":"أضف إلى السلة","viewProduct":"عرض المنتج","orderWhatsApp":"اطلب عبر واتساب","buildBox":"كوّن علبتك","visitUs":"زورونا","directions":"الاتجاهات إلى المحل","readStory":"اقرأ قصتنا","seeBoxes":"عرض علب الهدايا","discoverProducts":"اكتشف منتجاتنا","viewAllProducts":"عرض الكل","callShop":"اتصل بالمحل","send":"إرسال","notifyMe":"أعلموني عند توفره","requestQuote":"اطلب عرض سعر","backHome":"العودة إلى الرئيسية"},"footer":{"tagline":"« نكهات أصيلة، شغف حرفي. »","brandDesc":"الشاف سوزان، محل منتجات راقية ومطبخ في وهران.","subDesc":"مربى، بسكويت، شليطة، براج وطرشي نحضّرها بكميات صغيرة.","address":"حي عبد القادر، ترافيرسا، وهران","phone":"05 52 58 20 47","email":"shop@cheffesuzanne.com","hoursLabel":"أوقات العمل:","hours":"[من السبت إلى الخميس، من 9 صباحًا إلى 7 مساءً]","infoLabel":"معلومات","socialLabel":"التواصل:","deliveryLink":"التوصيل والاستلام","faqLink":"الأسئلة الشائعة","legalLink":"إشعار قانوني","copyright":"© 2026 الشاف سوزان"},"newsletter":{"title":"رسالة واحدة في الشهر، لا أكثر.","text":"أنواع المربى الجديدة حسب الموسم، مواعيد تحضير البراج، ووصفة من حين لآخر.","placeholder":"بريدك الإلكتروني","button":"اشترك","success":"تم التسجيل. تصلك الرسالة القادمة في بداية الشهر."}},"home":{"hero":{"eyebrow":"« نكهات أصيلة، شغف حرفي. »","title":"منتجات راقية وصناعة منزلية في وهران","subtitle":"مربى من فواكه الموسم، بسكويت، شليطة، براج وطرشي، نحضّرها في مطبخنا بكميات صغيرة."},"univers":{"title":"ما نحضّره في المطبخ","jamsTitle":"المربى التقليدي","jamsDesc":"فواكه الموسم، سكر، والوقت اللازم. لا شيء آخر.","biscuitsTitle":"بسكويت البيت","biscuitsDesc":"بسكويت بالزبدة وحلويات صغيرة، مع القهوة أو لاستقبال الضيوف.","chlitaTitle":"الشليطة التقليدية","chlitaDesc":"[وصف قصير يقدّمه صاحب العلامة.]","brajTitle":"البراج","brajDesc":"رقاقة السميد المحشوة بعجينة التمر، مطهوّة كما في البيت.","torchiTitle":"الطرشي (مخللات منزلية)","torchiDesc":"خضر مقرمشة في الخل، نعبّئها يدويًا."},"cheffe":{"title":"وراء كل برطمان، مطبخ","textP1":"بدأت الشاف سوزان في مطبخ عائلي. الوصفات ورثناها عن [أمي / جدتي]، ولم تتغير تقريبًا: نختار الفواكه من السوق، نطهوها، نملأ البرطمانات ونلصق الملصقات بأيدينا.","textP2":"اليوم أصبح ذلك المطبخ ورشة صغيرة ومحلًّا في وهران، نبيع فيه ما نحضّره، وبعض منتجات فلاحين نعرفهم.","signature":"سوزان"},"bestSellers":{"title":"الأكثر طلبًا","subtitle":"ما يعود زبائننا لشرائه."},"values":{"title":"طريقة عملنا","val1Title":"مكونات معروفة","val1Desc":"فواكه، سكر، سميد، تمر، زبدة، خل، توابل. بدون مواد حافظة وبدون نكهات مضافة.","val2Title":"كميات صغيرة","val2Desc":"نحضّر [بضع عشرات] من البرطمانات في كل مرة، وتاريخ التحضير مكتوب على كل ملصق.","val3Title":"موردون قريبون","val3Desc":"نشتري الفواكه والخضر من فلاحي منطقة وهران كلما سمح الموسم."},"giftBox":{"title":"هدية تُقتسم","text":"للعيد، لمولود جديد، لكلمة شكر أو لهدايا الشركات. اختر علبة جاهزة أو كوّن علبتك، ونحن نتكفّل بالتغليف والشريط."},"atelier":{"title":"في مطبخنا هذا الأسبوع","subtitle":"ما يُطهى، وما يجفّ، وما يخرج من الفرن. تابعونا على إنستغرام."},"reviews":{"title":"زبائننا يتحدثون عنا"},"visit":{"title":"مرّوا على المحل","text":"يمكنكم التذوق قبل الشراء، وإن كانت لديكم هدية نحضّر لكم علبة في الحين.","address":"حي عبد القادر، ترافيرسا، وهران · [أوقات العمل]","hoursLabel":"أوقات العمل:","hours":"[من السبت إلى الخميس: من 9 صباحًا إلى 7 مساءً · الجمعة: مغلق]"}},"cart":{"title":"سلة المشتريات","empty":"سلتك فارغة. ألقِ نظرة على مربيات الموسم.","subtotal":"المجموع الفرعي","shipping":"التوصيل","shippingNote":"يُحسب في الخطوة التالية","total":"المجموع","deliveryMode":"طريقة الاستلام:","pickupOption":"الاستلام من المحل (مجانًا)","deliveryOption":"التوصيل إلى المنزل","whatsappButton":"أرسل طلبي عبر واتساب","emailButton":"إرسال عبر البريد الإلكتروني","formName":"الاسم الكامل","formPhone":"رقم الهاتف","formAddress":"عنوان التوصيل (في حال التوصيل)","formNotes":"ملاحظات أو رسالة هدية (اختياري)","orderSuccess":"شكرًا! أُرسل طلبك عبر واتساب. سنؤكد لك التوفر ووقت الاستلام أو التوصيل.","soldOut":"غير متوفر حاليًا","priceUpcoming":"السعر يُحدد لاحقًا","close":"إغلاق","quantity":"الكمية","checkout":"متابعة الطلب","itemAdded":"تمت إضافة المنتج إلى السلة"},"products":{"h1":"منتجاتنا المصنوعة في البيت","intro":"كل ما تجدونه هنا محضّر في مطبخنا بوهران، بكميات صغيرة. المخزون يتغير مع المواسم: إن نفد منتج، راسلونا ونخبركم عند عودته.","filterAll":"الكل","filterConfitures":"المربى","filterBiscuits":"البسكويت","filterChlita":"الشليطة","filterBraj":"البراج","filterTorchi":"الطرشي","filterCoffrets":"علب الهدايا","sortBy":"ترتيب حسب","sortDefault":"الافتراضي","sortPriceAsc":"السعر: من الأقل للأعلى","sortPriceDesc":"السعر: من الأعلى للأقل","soldOut":"غير متوفر حاليًا","notifyMe":"أعلموني عند توفره","noProducts":"لا توجد منتجات تطابق اختيارك.","categoryIntros":{"confitures":{"title":"مربى تقليدي","text":"نتبع المواسم في مربياتنا: التين في آخر الصيف، البرتقال المرّ في الشتاء، والمشمش في الربيع. نطهوها في قدور صغيرة لنحافظ على طعم الفاكهة وقوام يبقى على الخبز. بدون مواد حافظة ولا ملوّنات."},"biscuits":{"title":"بسكويت البيت","text":"وصفات بسيطة بالزبدة، مذهّبة جيدًا. يُحفظ [من أسبوعين إلى ثلاثة] في علبته."},"chlita":{"title":"الشليطة التقليدية","text":"[نص يقدّمه صاحب العلامة.]"},"braj":{"title":"البراج","text":"البراج رقاقة من السميد محشوة بعجينة التمر، تُطهى في المقلاة أو على الطاجين. نحضّره كما في البيت: سميد، زبدة، تمر، وقليل من التوابل. نصنعه طوال السنة، وأكثر قليلًا مع قدوم الربيع."},"torchi":{"title":"الطرشي","text":"جزر، لفت، فلفل حار، ليمون: خضر مقرمشة محفوظة في خل متبّل. يرافق الأطباق بالمرق، والسندويتشات والمشويات."},"coffrets":{"title":"علب الهدايا","text":"نحضّر علبنا يدويًا في علبتنا الخضراء، بورق حريري وشريط. أضيفوا كلمة قصيرة ونكتبها لكم."}}},"productDetail":{"tabs":{"description":"الوصف","ingredients":"المكونات","storage":"طريقة الحفظ"},"allergensTitle":"يحتوي على (مسببات الحساسية):","allergensWarning":"يحتوي على:","relatedTitle":"قد يعجبك أيضًا","breadcrumbs":{"home":"الرئيسية","products":"منتجاتنا"},"weight":"الوزن:","quantity":"الكمية","addToCart":"أضف إلى السلة","priceUpcoming":"السعر يُحدد لاحقًا","inStock":"متوفر","outOfStock":"غير متوفر حاليًا","notifyWhatsApp":"أعلموني عبر واتساب"},"boxesPage":{"h1":"علب هدايا من منتجاتنا","intro":"نحضّر علبنا يدويًا في علبتنا الخضراء، بورق حريري وشريط. أضيفوا كلمة قصيرة ونكتبها لكم.","readyMadeTitle":"علبنا الجاهزة للإهداء","customBoxTitle":"كوّن علبتك","customBoxSubtitle":"اختر من 3 إلى 6 منتجات، ونحن نجهّز العلبة لك.","selectedCount":"{count} / 6 منتجات مختارة (3 على الأقل)","addCustomBoxToCart":"أضف علبتي المخصصة إلى السلة","minProductsWarning":"يرجى اختيار 3 منتجات على الأقل لتكوين علبتك.","maxProductsWarning":"يمكنك اختيار 6 منتجات كحد أقصى.","corporateTitle":"لعملائكم وفرقكم وضيوفكم","corporateText":"أعراس، خطوبات، أعياد، نهاية السنة: نحضّر علبًا بالكمية مع بطاقة باسمكم. يُرجى الطلب قبل [10 أيام] لأكثر من 20 علبة.","corporateButton":"اطلب عرض سعر عبر واتساب"},"storyPage":{"h1":"قصتنا","p1":"بدأ كل شيء في مطبخ عائلي بوهران. كانت [أمي] تحضّر المربى كل صيف، والبراج مع قدوم الربيع، والطرشي في برطمانات كبيرة نحفظها في الشرفة. بقيت أراقبها سنوات قبل أن أجرؤ على لمس القدر.","p2":"في [السنة]، بدأت أبيع بعض البرطمانات للجيران، ثم لأصدقاء الأصدقاء. كثرت الطلبات وضاق المطبخ. وفي [السنة]، فتحت الشاف سوزان محلّها، وخلفه مطبخ.","p3":"ما زلنا نعمل بالطريقة نفسها: نشتري ما هو في موسمه، نطهو بكميات صغيرة، ولا نضع في برطمان ما لا نقدّمه على مائدتنا. وإلى جانب منتجاتنا، ستجدون منتجات اخترناها من فلاحين نعرفهم شخصيًا: زيوت، عسل، وتوابل.","p4":"إن مررتم على المحل، فغالبًا هناك شيء يُطهى. لا تترددوا في طلب التذوق.","signature":"سوزان","stats":"[X] وصفات · [X] برطمان أسبوعيًا · [X] فلاحين شركاء"},"shopPage":{"h1":"محل المنتجات الراقية في وهران","text":"يقع المحل في حي عبد القادر، ترافيرسا. ستجدون فيه كل منتجاتنا، ومنتجات راقية مختارة، وعلب هدايا جاهزة. نأخذ وقتنا لنجعلكم تتذوقون ونساعدكم في الاختيار.","addressTitle":"العنوان","address":"حي عبد القادر، ترافيرسا، وهران 31002","hoursTitle":"أوقات العمل","hours":"[السبت – الخميس: 9 صباحًا – 7 مساءً · الجمعة: مغلق]","accessTitle":"المعالم والوصول","access":"[معلم قريب، موقف سيارات…]","directions":"الاتجاهات إلى المحل","call":"الاتصال بالمحل"},"contactPage":{"h1":"الاتصال والطلبات","text":"سؤال عن منتج، طلب لمناسبة، حساسية من مكوّن؟ راسلونا أو اتصلوا بنا، نرد [في اليوم نفسه].","formName":"الاسم","formPhone":"الهاتف","formEmail":"البريد الإلكتروني (اختياري)","formMessage":"رسالتك","formSubmit":"إرسال","formSuccess":"شكرًا، وصلتنا رسالتك. سنرد عليك [في اليوم نفسه].","whatsappTitle":"الأسرع:","whatsappText":"راسلونا على واتساب 05 52 58 20 47."},"deliveryPage":{"h1":"التوصيل والاستلام","pickupTitle":"الاستلام من المحل","pickupText":"مجاني. يكون الطلب جاهزًا خلال [ساعتين] في أوقات العمل.","oranTitle":"التوصيل داخل وهران","oranText":"[— دج]، خلال [24 إلى 48 ساعة].","wilayasTitle":"الولايات الأخرى","wilayasText":"[يُؤكد لاحقًا].","paymentTitle":"الدفع","paymentText":"نقدًا عند الاستلام أو في المحل [أو بالبطاقة].","freshTitle":"المنتجات الطازجة","freshText":"البراج يُحفظ بضعة أيام، لذلك نحضّره حسب الطلب ونوصله داخل وهران فقط."},"faqPage":{"h1":"الأسئلة الشائعة","items":[{"q":"هل تحتوي مربياتكم على مواد حافظة؟","a":"لا. تحتوي على فواكه وسكر وأحيانًا عصير ليمون. السكر والطهي يكفيان لحفظها."},{"q":"كم يدوم المربى بعد الفتح؟","a":"حوالي ثلاثة أسابيع في الثلاجة، مع استعمال ملعقة نظيفة في كل مرة."},{"q":"كم يدوم البراج؟","a":"[5 أيام] في درجة حرارة الغرفة، ملفوفًا جيدًا. ويمكن تجميده وتسخينه في المقلاة."},{"q":"هل توصلون خارج وهران؟","a":"[يُؤكد لاحقًا]"},{"q":"هل يمكن الطلب لعرس أو مناسبة؟","a":"نعم. اتصلوا بنا قبل [10 أيام] على الأقل للكميات الكبيرة."},{"q":"هل منتجاتكم حلال؟","a":"[يُؤكد من طرف العلامة]"},{"q":"مسببات الحساسية؟","a":"البسكويت والبراج يحتويان على الغلوتين والحليب، وبعض أنواع البسكويت تحتوي على البيض والمكسرات. كل ذلك مذكور في صفحة كل منتج وعلى الملصق."}]},"legalNoticePage":{"h1":"إشعار قانوني","text":"[يُحرر بالمعلومات القانونية للشركة : السجل التجاري، المعرف الجبائي، العنوان، مسؤول النشر، المستضيف.]"},"journalPage":{"h1":"يوميات الشاف","emptyState":"المقالات الأولى من يوميات مطبخنا قادمة قريبًا جدًا: وصفات عائلية، كواليس الورشة، ونصائح الحفظ."}},"children":["$","$Lc",null,{"children":["$Ld",["$","$Le",null,{}],["$","main",null,{"className":"flex-1","children":["$","$L3",null,{"parallelRouterKey":"children","segmentPath":["children","$4","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L5",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":["$","$Lf",null,{}],"notFoundStyles":[]}]}],"$L10",["$","$L11",null,{}]]}]}]
