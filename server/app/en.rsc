home"},"footer":{"tagline":"« Authentic flavours, handcrafted passion. »","brandDesc":"Cheffe Suzanne, a fine food shop and kitchen in Oran.","subDesc":"Jams, biscuits, chlita, braj and torchi made in small batches.","address":"Hai Abdelkader, Traversa, Oran","phone":"+213 552 58 20 47","email":"shop@cheffesuzanne.com","hoursLabel":"Hours:","hours":"[Saturday to Thursday, 9am – 7pm]","infoLabel":"Information","socialLabel":"Social:","deliveryLink":"Delivery and pickup","faqLink":"FAQ","legalLink":"Legal notice","copyright":"© 2026 Cheffe Suzanne"},"newsletter":{"title":"One letter a month, no more.","text":"New seasonal jams, braj baking days and the occasional recipe.","placeholder":"Your email","button":"Sign up","success":"Done. The next letter arrives at the start of the month."}},"home":{"hero":{"eyebrow":"« Authentic flavours, handcrafted passion. »","title":"Fine food and homemade preserves in Oran","subtitle":"Seasonal fruit jams, biscuits, chlita, braj and torchi, made in our kitchen in small batches."},"univers":{"title":"What we make","jamsTitle":"Artisan jams","jamsDesc":"Seasonal fruit, sugar, and the time it takes. Nothing else.","biscuitsTitle":"Homemade biscuits","biscuitsDesc":"Butter shortbreads and small cakes, for coffee or for guests.","chlitaTitle":"Traditional chlita","chlitaDesc":"[Short description to be provided by the brand.]","brajTitle":"Braj","brajDesc":"A semolina flatbread filled with date paste, cooked the way it's done at home.","torchiTitle":"Torchi (homemade pickles)","torchiDesc":"Crunchy vegetables pickled in vinegar, jarred by hand."},"cheffe":{"title":"Behind every jar, there's a kitchen","textP1":"Cheffe Suzanne started as a family kitchen. The recipes come from [my mother / my grandmother] and have barely changed: we pick the fruit at the market, cook it, fill the jars and label them by hand.","textP2":"Today that kitchen is a small workshop and shop in Oran. We sell what we make, plus a few products from growers we know.","signature":"Suzanne"},"bestSellers":{"title":"Most requested","subtitle":"What our customers come back for."},"values":{"title":"How we work","val1Title":"Ingredients you can name","val1Desc":"Fruit, sugar, semolina, dates, butter, vinegar, spices. No preservatives, no added flavourings.","val2Title":"Small batches","val2Desc":"We cook [a few dozen] jars at a time. The production date is written on every label.","val3Title":"Local suppliers","val3Desc":"We buy our fruit and vegetables from growers around Oran whenever the season allows."},"giftBox":{"title":"A gift meant for sharing","text":"For Eid, a new baby, a thank-you or a corporate gift. Pick a ready-made box or build your own. We take care of the paper and ribbon."},"atelier":{"title":"In the kitchen this week","subtitle":"What's cooking, drying and coming out of the oven. Follow us on Instagram."},"reviews":{"title":"In our customers' words"},"visit":{"title":"Come by the shop","text":"You can taste before you buy. If you need a gift, we'll put a box together for you on the spot.","address":"Hai Abdelkader, Traversa, Oran · [Hours]","hoursLabel":"Hours:","hours":"[Saturday to Thursday: 9am – 7pm · Friday: closed]"}},"cart":{"title":"Your Cart","empty":"Your cart is empty. Have a look at our seasonal jams.","subtotal":"Subtotal","shipping":"Delivery","shippingNote":"calculated at next step","total":"Total","deliveryMode":"Receiving method:","pickupOption":"Pickup at the shop (free)","deliveryOption":"Home delivery","whatsappButton":"Send my order on WhatsApp","emailButton":"Send via email","formName":"Full name","formPhone":"Phone number","formAddress":"Delivery address (if delivery)","formNotes":"Notes or gift message (optional)","orderSuccess":"Thank you! Your order has been sent on WhatsApp. We'll confirm availability and the pickup or delivery time.","soldOut":"Sold out for now","priceUpcoming":"Price to be announced","close":"Close","quantity":"Quantity","checkout":"Checkout","itemAdded":"Product added to cart"},"products":{"h1":"Our homemade products","intro":"Everything here is made in our kitchen in Oran, in small batches. Stock follows the seasons. If something is sold out, message us and we'll let you know when it's back.","filterAll":"All","filterConfitures":"Jams","filterBiscuits":"Biscuits","filterChlita":"Chlita","filterBraj":"Braj","filterTorchi":"Torchi","filterCoffrets":"Gift boxes","sortBy":"Sort by","sortDefault":"Default","sortPriceAsc":"Price: low to high","sortPriceDesc":"Price: high to low","soldOut":"Sold out for now","notifyMe":"Notify me","noProducts":"No products found matching your criteria.","categoryIntros":{"confitures":{"title":"Artisan jams","text":"Our jams follow the seasons: figs at the end of summer, bitter oranges in winter, apricots in spring. We cook them in small pans to keep the taste of the fruit and a texture that stays on the bread. No preservatives or colourings."},"biscuits":{"title":"Homemade biscuits","text":"Simple, golden butter recipes. They keep for [two to three weeks] in their tin."},"chlita":{"title":"Traditional chlita","text":"[Text to be provided by the brand.]"},"braj":{"title":"Braj","text":"Braj is a semolina flatbread filled with date paste and cooked in a pan or on a tadjine. We make it the home way: semolina, butter, dates, a pinch of spice. We make it all year, and a little more when spring comes."},"torchi":{"title":"Torchi (homemade pickles)","text":"Carrots, turnips, chillies, lemons: crunchy vegetables kept in spiced vinegar. Torchi goes with stews, sandwiches and grilled meat."},"coffrets":{"title":"Gift boxes","text":"Our boxes are put together by hand in our green box, with tissue paper and a ribbon. Add a short note and we'll write it for you."}}},"productDetail":{"tabs":{"description":"Description","ingredients":"Ingredients","storage":"Storage"},"allergensTitle":"Contains (allergens):","allergensWarning":"Contains:","relatedTitle":"You might also like","breadcrumbs":{"home":"Home","products":"Our products"},"weight":"Weight:","quantity":"Quantity","addToCart":"Add to cart","priceUpcoming":"Price to be announced","inStock":"In stock","outOfStock":"Sold out for now","notifyWhatsApp":"Notify me on WhatsApp"},"boxesPage":{"h1":"Food gift boxes","intro":"Our boxes are put together by hand in our green box, with tissue paper and a ribbon. Add a short note and we'll write it for you.","readyMadeTitle":"Our ready-made boxes","customBoxTitle":"Build my box","customBoxSubtitle":"Choose 3 to 6 products, we assemble the box for you.","selectedCount":"{count} / 6 products selected (minimum 3)","addCustomBoxToCart":"Add custom box to cart","minProductsWarning":"Please select at least 3 products to build your box.","maxProductsWarning":"You can select up to 6 products.","corporateTitle":"For your clients, teams and guests","corporateText":"Weddings, engagements, Eid, end of year: we make boxes in quantity, with a card in your name. Allow [10 days] for more than 20 boxes.","corporateButton":"Request a quote on WhatsApp"},"storyPage":{"h1":"Our story","p1":"It all started in a family kitchen in Oran. [My mother] made her jams every summer, braj when spring came, and torchi in big jars kept on the balcony. I watched her for years before I dared touch the pot.","p2":"In [year], I started selling a few jars to neighbours, then to friends of friends. The orders grew and the kitchen became too small. In [year], Cheffe Suzanne opened its shop, with a kitchen right behind it.","p3":"We still work the same way: we buy what's in season, cook in small quantities, and never put anything in a jar that we wouldn't serve at our own table. Next to our own preserves you'll also find products from growers we know personally: oils, honeys, spices.","p4":"If you come by the shop, something is often cooking. Feel free to ask for a taste.","signature":"Suzanne","stats":"[X] recipes · [X] jars a week · [X] partner growers"},"shopPage":{"h1":"Our fine food shop in Oran","text":"The shop is in Hai Abdelkader, Traversa. You'll find all our preserves, selected fine food products and gift boxes ready to give. We take the time to let you taste and to help you choose.","addressTitle":"Address","address":"Hai Abdelkader, Traversa, Oran 31002","hoursTitle":"Hours","hours":"[Saturday – Thursday: 9am – 7pm · Friday: closed]","accessTitle":"Access & landmarks","access":"[Nearby landmark, parking…]","directions":"Get directions","call":"Call the shop"},"contactPage":{"h1":"Contact and orders","text":"A question about a product, an order for an event, an allergy? Write or call us, we reply [the same day].","formName":"Name","formPhone":"Phone","formEmail":"Email (optional)","formMessage":"Your message","formSubmit":"Send","formSuccess":"Thank you, your message has arrived. We'll reply [the same day].","whatsappTitle":"Fastest:","whatsappText":"Message us on WhatsApp at +213 552 58 20 47."},"deliveryPage":{"h1":"Delivery and pickup","pickupTitle":"Pickup at the shop","pickupText":"Free. Ready [within 2 hours] during opening hours.","oranTitle":"Delivery in Oran","oranText":"[— DZD], within [24–48 h].","wilayasTitle":"Other wilayas","wilayasText":"[to confirm].","paymentTitle":"Payment","paymentText":"Cash on delivery or at the shop [or by card].","freshTitle":"Fresh products","freshText":"Braj keeps a few days, so we make it to order and deliver it in Oran only."},"faqPage":{"h1":"FAQ","items":[{"q":"Do your jams contain preservatives?","a":"No. They contain fruit, sugar and sometimes lemon juice. Sugar and cooking are enough to preserve them."},{"q":"How long does an opened jar of jam keep?","a":"About three weeks in the fridge, using a clean spoon each time."},{"q":"How long does braj keep?","a":"[5 days] at room temperature, well wrapped. It also freezes well and can be warmed in a pan."},{"q":"Do you deliver outside Oran?","a":"[to confirm]"},{"q":"Can I order for a wedding or an event?","a":"Yes. Contact us at least [10 days] ahead for large quantities."},{"q":"Are your products halal?","a":"[to confirm]"},{"q":"Allergens?","a":"Our biscuits and braj contain gluten and milk. Some biscuits contain eggs and nuts. Everything is listed on each product page and label."}]},"legalNoticePage":{"h1":"Legal notice","text":"[To be drafted with company legal info.]"},"journalPage":{"h1":"The Cheffe's Journal","emptyState":"Our first kitchen journal articles are coming very soon. Family recipes, workshop stories, and preservation tips."}},"children":["$","$L21",null,{"children":[["$","div",null,{"className":"bg-suzanne text-suzanne-turquoise text-xs font-medium py-2 px-3 text-center tracking-wide border-b border-suzanne-dark/30 overflow-hidden","children":["$","div",null,{"className":"max-w-7xl mx-auto flex items-center justify-center gap-2 flex-wrap text-center","children":[["$","span",null,{"className":"inline-block w-1.5 h-1.5 rounded-full bg-suzanne-turquoise animate-pulse flex-shrink-0"}],["$","p",null,{"className":"leading-snug","children":"Delivery in Oran within [24–48 h] · Free pickup at the shop"}]]}]}],["$","$L22",null,{}],["$","main",null,{"className":"flex-1","children":["$","$Ld",null,{"parallelRouterKey":"children","segmentPath":["children","$23","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$Le",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":["$","$L24",null,{}],"notFoundStyles":[]}]}],["$","footer",null,{"className":"bg-suzanne text-suzanne-creme border-t border-suzanne-dark/60 pt-16 pb-12","children":["$","div",null,{"className":"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8","children":[["$","div",null,{"className":"grid grid-cols-1 md:grid-cols-4 gap-10 lg:gap-12 mb-12","children":[["$","div",null,{"className":"space-y-4 md:col-span-1","children":[["$","div",null,{"className":"relative h-10 w-44","children":["$","$L10",null,{"src":"/images/brand/logo-blanc.png","alt":"Cheffe Suzanne","fill":true,"className":"object-contain object-lef