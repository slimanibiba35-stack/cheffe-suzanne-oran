2:["$","div",null,{"className":"bg-suzanne-creme min-h-screen pb-16","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://cheffesuzanne.com/en\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Our homemade products\",\"item\":\"https://cheffesuzanne.com/en/products\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Homemade biscuits\",\"item\":\"https://cheffesuzanne.com/en/products/biscuits\"}]}"}}],["$","div",null,{"className":"bg-suzanne text-suzanne-creme pt-8 pb-10 border-b border-suzanne-dark","children":["$","div",null,{"className":"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8","children":[["$","nav",null,{"aria-label":"Breadcrumb","className":"mb-4 flex items-center gap-1.5 text-xs text-suzanne-creme/70","children":["$L9",["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-right w-3.5 h-3.5 rtl:rotate-180","children":[["$","path","mthhwq",{"d":"m9 18 6-6-6-6"}],"$undefined"]}],"$La",["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-right w-3.5 h-3.5 rtl:rotate-180","children":[["$","path","mthhwq",{"d":"m9 18 6-6-6-6"}],"$undefined"]}],["$","span",null,{"className":"text-suzanne-turquoise font-medium","aria-current":"page","children":"Homemade biscuits"}]]}],["$","h1",null,{"className":"text-3xl sm:text-4xl md:text-5xl font-serif font-bold text-balance","children":"Homemade biscuits"}]]}]}],["$","div",null,{"className":"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 sm:pt-10","children":[["$","div",null,{"className":"bg-white rounded-brand border border-suzanne/10 p-6 sm:p-8 mb-10 shadow-sm max-w-4xl","children":[["$","h2",null,{"className":"text-xl font-serif font-bold text-suzanne mb-3","children":"Homemade biscuits"}],["$","p",null,{"className":"text-sm sm:text-base text-suzanne/85 leading-relaxed font-light","children":"Simple, golden butter recipes. They keep for [two to three weeks] in their tin."}]]}],["$","$Lb",null,{"products":[{"id":"confiture-de-figues","slug":{"fr":"confiture-de-figues","en":"fig-jam"},"name":{"fr":"Confiture de figues","en":"Fig jam","ar":"مربى التين"},"range":"confitures","shortDescription":{"fr":"Des figues mûres cuites doucement, avec une pointe de citron.","en":"Ripe figs cooked slowly with a little lemon.","ar":"تين ناضج مطهو على نار هادئة مع قليل من الليمون."},"description":{"fr":"On attend que les figues soient bien mûres avant de les cuire, pour qu'elles donnent leur sucre naturel. Le résultat est une confiture épaisse, avec des morceaux, qui va aussi bien sur le pain que sur un fromage.","en":"We wait for the figs to be fully ripe so they bring their own sweetness. Thick, with pieces of fruit, good on bread or with cheese.","ar":"ننتظر أن ينضج التين تمامًا ليمنح حلاوته الطبيعية. مربى كثيف بقطع الفاكهة، يناسب الخبز والجبن."},"ingredients":{"fr":"Figues, sucre, jus de citron. [à confirmer]","en":"Figs, sugar, lemon juice. [to confirm]","ar":"تين، سكر، عصير ليمون. [يُؤكد لاحقًا]"},"storage":{"fr":"Avant ouverture, à l'abri de la lumière. Après ouverture, au réfrigérateur, à consommer sous 3 semaines.","en":"Before opening, keep away from light. After opening, refrigerate and eat within 3 weeks.","ar":"قبل الفتح، بعيدًا عن الضوء. بعد الفتح، في الثلاجة ويُستهلك خلال 3 أسابيع."},"allergens":[],"weight":"[250 g]","price":0,"currency":"DZD","image":"/images/bannieres/banniere-confitures.jpg","badges":["Sans conservateur"],"inStock":true,"featured":true},{"id":"confiture-d-abricots","slug":{"fr":"confiture-d-abricots","en":"apricot-jam"},"name":{"fr":"Confiture d'abricots","en":"Apricot jam","ar":"مربى المشمش"},"range":"confitures","shortDescription":{"fr":"Abricots en morceaux, légèrement acidulée.","en":"Apricot pieces, slightly tart.","ar":"قطع مشمش، بحموضة خفيفة."},"description":{"fr":"Une confiture qui garde le côté acidulé de l'abricot. On la cuit rapidement pour que les morceaux restent entiers.","en":"Cooked quickly so the pieces stay whole.","ar":"نطهوه بسرعة لتبقى القطع كاملة."},"ingredients":{"fr":"Abricots, sucre, jus de citron. [à confirmer]","en":"Apricots, sugar, lemon juice. [to confirm]","ar":"مشمش، سكر، عصير ليمون. [يُؤكد لاحقًا]"},"storage":{"fr":"Avant ouverture, à l'abri de la lumière. Après ouverture, au réfrigérateur, à consommer sous 3 semaines.","en":"Before opening, keep away from light. After opening, refrigerate and eat within 3 weeks.","ar":"قبل الفتح، بعيدًا عن الضوء. بعد الفتح، في الثلاجة ويُستهلك خلال 3 أسابيع."},"allergens":[],"weight":"[250 g]","price":0,"currency":"DZD","image":"/images/produits/confitures-biscuits.jpg","badges":["Sans conservateur","Fait maison"],"inStock":true,"featured":false},{"id":"confiture-d-oranges-ameres","slug":{"fr":"confiture-d-oranges-ameres","en":"bitter-orange-marmalade"},"name":{"fr":"Confiture d'oranges amères","en":"Bitter orange marmalade","ar":"مربى البرتقال المرّ"},"range":"confitures","shortDescription":{"fr":"Une confiture d'agrumes avec une belle amertume.","en":"A citrus jam with a pleasant bitterness.","ar":"مربى حمضيات بمرارة لطيفة."},"description":{"fr":"Préparée en hiver avec des oranges amères coupées à la main. Pour ceux qui aiment les confitures moins sucrées.","en":"Made in winter with hand-cut bitter oranges, for those who like their jam less sweet.","ar":"يُحضّر في الشتاء من برتقال مرّ مقطّع باليد، لمن يحب المربى الأقل حلاوة."},"ingredients":{"fr":"Oranges amères, sucre. [à confirmer]","en":"Bitter oranges, sugar. [to confirm]","ar":"برتقال مرّ، سكر. [يُؤكد لاحقًا]"},"storage":{"fr":"Avant ouverture, à l'abri de la lumière. Après ouverture, au réfrigérateur, à consommer sous 3 semaines.","en":"Before opening, keep away from light. After opening, refrigerate and eat within 3 weeks.","ar":"قبل الفتح، بعيدًا عن الضوء. بعد الفتح، في الثلاجة ويُستهلك خلال 3 أسابيع."},"allergens":[],"weight":"[250 g]","price":0,"currency":"DZD","image":"/images/bannieres/banniere-confitures.jpg","badges":["Sans conservateur"],"inStock":true,"featured":false},{"id":"sables-au-beurre","slug":{"fr":"sables-au-beurre","en":"butter-shortbread"},"name":{"fr":"Sablés au beurre","en":"Butter shortbread","ar":"بسكويت بالزبدة"},"range":"biscuits","shortDescription":{"fr":"Le sablé tout simple, au beurre, bien doré.","en":"Plain, buttery and golden.","ar":"بسيط، بالزبدة، ومذهّب."},"description":{"fr":"Une pâte au beurre, un peu de sucre, une cuisson lente. C'est le biscuit qu'on sert avec le café à la boutique.","en":"The biscuit we serve with coffee at the shop.","ar":"البسكويت الذي نقدّمه مع القهوة في المحل."},"ingredients":{"fr":"Farine, beurre, sucre, œufs, sel. Contient : gluten, lait, œufs.","en":"Flour, butter, sugar, eggs, salt. Contains: gluten, milk, eggs.","ar":"فرينة، زبدة، سكر، بيض، ملح. يحتوي على: غلوتين، حليب، بيض."},"storage":{"fr":"Dans sa boîte fermée, [3 semaines].","en":"In its sealed tin, [3 weeks].","ar":"في علبته المغلقة، [3 أسابيع]."},"allergens":["gluten","lait","œufs"],"weight":"[200 g]","price":0,"currency":"DZD","image":"/images/produits/confitures-biscuits.jpg","badges":["Fait maison"],"inStock":true,"featured":true},{"id":"biscuits-aux-amandes","slug":{"fr":"biscuits-aux-amandes","en":"almond-biscuits"},"name":{"fr":"Biscuits aux amandes","en":"Almond biscuits","ar":"بسكويت باللوز"},"range":"biscuits","shortDescription":{"fr":"Croquants, avec des amandes grillées.","en":"Crunchy, with roasted almonds.","ar":"مقرمش، بلوز محمّص."},"description":{"fr":"Des biscuits secs aux amandes torréfiées à l'atelier, parfaits à tremper dans le thé.","en":"Roasted in our kitchen, perfect for dipping in tea.","ar":"نحمّص اللوز في مطبخنا، مثالي مع الشاي."},"ingredients":{"fr":"Farine, amandes, sucre, beurre, œufs. Contient : gluten, fruits à coque, lait, œufs.","en":"Flour, almonds, sugar, butter, eggs. Contains: gluten, nuts, milk, eggs.","ar":"فرينة، لوز، سكر، زبدة، بيض. يحتوي على: غلوتين، مكسرات، حليب، بيض."},"storage":{"fr":"Dans sa boîte fermée, [3 semaines].","en":"In its sealed tin, [3 weeks].","ar":"في علبته المغلقة، [3 أسابيع]."},"allergens":["gluten","fruits à coque","lait","œufs"],"weight":"[200 g]","price":0,"currency":"DZD","image":"/images/produits/confitures-biscuits.jpg","badges":["Fait maison"],"inStock":true,"featured":false},{"id":"chlita-de-la-cheffe","slug":{"fr":"chlita-de-la-cheffe","en":"cheffes-chlita"},"name":{"fr":"Chlita de la Cheffe","en":"Cheffe's chlita","ar":"شليطة الشاف"},"range":"chlita","shortDescription":{"fr":"[Description courte à fournir par la marque : 1 phrase sur ce qu'est la chlita de la maison.]","en":"[Short description to be provided by the brand.]","ar":"[وصف قصير يقدّمه صاحب العلامة.]"},"description":{"fr":"[Texte à fournir par la marque : origine de la recette, ingrédients principaux, comment on la mange.]","en":"[Text to be provided by the brand: recipe origin, main ingredients, how it is enjoyed.]","ar":"[نص يقدّمه صاحب العلامة: أصل الوصفة، المكونات الرئيسية، طريقة التناول.]"},"ingredients":{"fr":"[Ingrédients à fournir]","en":"[Ingredients to be provided]","ar":"[المكونات تُحدد لاحقًا]"},"storage":{"fr":"Au frais après ouverture, couverte d'huile d'olive. [à confirmer]","en":"Refrigerate after opening, covered with olive oil. [to confirm]","ar":"في الثلاجة بعد الفتح، مغطاة بزيت الزيتون. [يُؤكد لاحقًا]"},"allergens":[],"weight":"[—]","price":0,"currency":"DZD","image":"/images/atelier/atelier-pains-bocaux.jpg","badges":["Fait maison"],"inStock":true,"featured":false},{"id":"braj-aux-dattes","slug":{"fr":"braj-aux-dattes","en":"date-braj"},"name":{"fr":"Braj aux dattes","en":"Date braj","ar":"براج بالتمر"},"range":"braj","shortDescription":{"fr":"Galette de semoule fourrée à la pâte de dattes.","en":"Semolina flatbread filled with date paste.","ar":"رقاقة سميد محشوة بعجينة التمر."},"description":{"fr":"Une pâte de semoule au beurre, une couche épaisse de dattes, une cuisson lente jusqu'à ce que les bords dorent. Se coupe en losanges et se partage au goûter, avec un lait ou un thé.","en":"Butter semolina dough, a thick layer of dates, slow-cooked until the edges turn golden. Cut into diamonds and shared at teatime.","ar":"عجينة سميد بالزبدة، طبقة سميكة من التمر، وطهي هادئ حتى تذهب الحواف. يُقطّع معيّنات ويُقتسم في وقت القهوة."},"ingredients":{"fr":"Semoule de blé, pâte de dattes, beurre, sel, [épices]. Contient : gluten, lait.","en":"Wheat semolina, date paste, butter, salt, [spices]. Contains: gluten, milk.","ar":"سميد قمح، عجينة تمر، زبدة، ملح، [توابل]. يحتوي على: غلوتين، حليب."},"storage":{"fr":"[5 jours] à température ambiante, dans un linge ou une boîte.","en":"[5 days] at room temperature, well wrapped.","ar":"[5 أيام] في درجة حرارة الغرفة، ملفوفًا جيدًا."},"allergens":["gluten","lait"],"weight":"[—]","price":0,"currency":"DZD","image":"/images/produits/braj-coffret-vert.jpg","badges":["Fait maison"],"inStock":true,"featured":true},{"id":"torchi-de-legumes","slug":{"fr":"torchi-de-legumes","en":"vegetable-torchi"},"name":{"fr":"Torchi de légumes","en":"Vegetable torchi","ar":"طرشي الخضر"},"range":"torchi","shortDescription":{"fr":"Carottes, navets et piments au vinaigre, bien croquants.","en":"Carrots, turnips and chillies in vinegar, nice and crunchy.","ar":"جزر ولفت وفلفل في الخل، مقرمش."},"description":{"fr":"Des légumes coupés à la main et conservés dans un vinaigre aux épices. Comptez [une semaine] de repos avant qu'ils prennent tout leur goût : on les met en vente quand ils sont prêts.","en":"Hand-cut vegetables in spiced vinegar. They rest for [a week] before they're ready to sell.","ar":"خضر مقطعة باليد في خل متبّل، تُترك [أسبوعًا] قبل أن تصبح جاهزة للبيع."},"ingredients":{"fr":"Carottes, navets, piments, vinaigre, eau, sel, ail, épices. [à confirmer]","en":"Carrots, turnips, chillies, vinegar, water, salt, garlic, spices. [to confirm]","ar":"جزر، لفت، فلفل حار، خل، ماء، ملح، ثوم، توابل. [يُؤكد لاحقًا]"},"storage":{"fr":"Au réfrigérateur après ouverture, légumes toujours couverts de liquide.","en":"Refrigerate after opening, vegetables always kept under brine.","ar":"في الثلاجة بعد الفتح، الخضر مغطاة دائمًا بالسائل."},"allergens":[],"weight":"[500 g]","price":0,"currency":"DZD","image":"/images/bannieres/banniere-pickles.jpg","badges":["Fait maison","Sans conservateur"],"inStock":true,"featured":true},{"id":"citrons-confits","slug":{"fr":"citrons-confits","en":"preserved-lemons"},"name":{"fr":"Citrons confits","en":"Preserved lemons","ar":"ليمون مصيّر"},"range":"torchi","shortDescription":{"fr":"Citrons confits au sel, pour les tajines et les salades.","en":"Salt-preserved lemons for tagines and salads.","ar":"ليمون محفوظ في الملح للطواجن والسلطات."},"description":{"fr":"Des citrons entiers confits dans le sel pendant [plusieurs semaines]. On utilise surtout l'écorce, coupée fin, dans les plats mijotés.","en":"Mostly the rind is used, finely chopped, in slow-cooked dishes.","ar":"يُستعمل القشر خاصة، مقطعًا رقيقًا، في الأطباق المطهوة ببطء."},"ingredients":{"fr":"Citrons, sel.","en":"Lemons, salt.","ar":"ليمون، ملح."},"storage":{"fr":"Au frais après ouverture, citrons immergés dans leur saumure.","en":"Keep cool after opening, submerged in brine.","ar":"في مكان بارد بعد الفتح، مغمورًا في ماء الملح."},"allergens":[],"weight":"[—]","price":0,"currency":"DZD","image":"/images/bannieres/banniere-pickles.jpg","badges":["Fait maison"],"inStock":true,"featured":false},{"id":"coffret-decouverte","slug":{"fr":"coffret-decouverte","en":"discovery-box"},"name":{"fr":"Coffret Découverte","en":"Discovery box","ar":"علبة الاكتشاف"},"range":"coffrets","shortDescription":{"fr":"2 confitures + 1 boîte de biscuits. Pour un premier cadeau, ou pour faire goûter la maison.","en":"2 jams + 1 tin of biscuits. For a first gift or to share a taste of the kitchen.","ar":"مربيان + علبة بسكويت. كهدية أولى أو لتذوق منتجاتنا."},"description":{"fr":"Nos coffrets sont préparés à la main dans notre boîte verte, avec du papier de soie et un ruban. Vous pouvez glisser un petit mot : on l'écrit pour vous. Ce coffret contient 2 pots de confitures artisanales de saison et 1 boîte de nos sablés au beurre dorés.","en":"Our boxes are put together by hand in our green box, with tissue paper and a ribbon. Add a short note and we'll write it for you. Includes 2 jars of seasonal artisan jam and 1 tin of golden butter shortbreads.","ar":"نحضّر علبنا يدويًا في علبتنا الخضراء، بورق حريري وشريط. أضيفوا كلمة قصيرة ونكتبها لكم. تحتوي على برطمانين من مربى الموسم وعلبة بسكويت بالزبدة."},"ingredients":{"fr":"Voir le détail sur chaque produit composant le coffret.","en":"See individual product listings for ingredients.","ar":"انظر تفاصيل كل منتج داخل العلبة."},"storage":{"fr":"À conserver dans un endroit frais et sec.","en":"Store in a cool, dry place.","ar":"يُحفظ في مكان بارد وجاف."},"allergens":["gluten","lait","œufs"],"weight":"[Coffret 3 pièces]","price":0,"currency":"DZD","image":"/images/produits/braj-coffret-vert.jpg","badges":[],"inStock":true,"featured":false},{"id":"coffret-du-gouter","slug":{"fr":"coffret-du-gouter","en":"teatime-box"},"name":{"fr":"Coffret du Goûter","en":"Teatime box","ar":"علبة القهوة"},"range":"coffrets","shortDescription":{"fr":"1 braj, 1 confiture, 1 boîte de sablés. Le coffret qu'on emporte quand on est invité.","en":"1 braj, 1 jam, 1 tin of shortbread. The box you bring when invited.","ar":"براج، مربى، وعلبة بسكويت بالزبدة. العلبة المثالية عند الزيارة."},"description":{"fr":"Le coffret gourmand pour accompagner le café ou le thé de l'après-midi : une part généreuse de braj aux dattes tout frais, un pot de confiture de saison et une boîte de nos sablés traditionnels.","en":"The teatime box: freshly baked date braj, seasonal fruit jam, and a tin of traditional butter shortbread.","ar":"علبة شاي بعد الظهر: براج طازج بالتمر، مربى فواكه الموسم، وعلبة بسكويت بالزبدة."},"ingredients":{"fr":"Voir le détail sur chaque produit composant le coffret.","en":"See individual product listings for ingredients.","ar":"انظر تفاصيل كل منتج داخل العلبة."},"storage":{"fr":"Consommer le braj sous [5 jours].","en":"Consume braj within [5 days].","ar":"يُستهلك البراج خلال [5 أيام]."},"allergens":["gluten","lait","œufs"],"weight":"[Coffret 3 pièces]","price":0,"currency":"DZD","image":"/images/produits/braj-coffret-vert.jpg","badges":["Fait maison"],"inStock":true,"featured":false},{"id":"coffret-de-la-table","slug":{"fr":"coffret-de-la-table","en":"kitchen-box"},"name":{"fr":"Coffret de la Table","en":"Kitchen box","ar":"علبة المائدة"},"range":"coffrets","shortDescription":{"fr":"1 torchi, 1 citrons confits, 1 confiture, 1 boîte de biscuits. Pour ceux qui aiment cuisiner.","en":"1 torchi, 1 preserved lemons, 1 jam, 1 tin of biscuits. For those who love to cook.","ar":"طرشي، ليمون مصيّر، مربى، وعلبة بسكويت. لعشاق الطبخ."},"description":{"fr":"L'assortiment complet mêlant le salé et le sucré : nos légumes croquants en torchi, des citrons confits pour parfumer les plats mijotés, une confiture fruitée et des biscuits pour la touche sucrée.","en":"A complete mix of sweet and savoury: crunchy pickled torchi, preserved lemons for rich tagines, fruit jam, and butter biscuits.","ar":"تشكيلة متكاملة تجمع الحلو والمالح: طرشي الخضر المقرمشة، ليمون مصيّر للأطباق، مربى فاخر، وبسكويت شهي."},"ingredients":{"fr":"Voir le détail sur chaque produit composant le coffret.","en":"See individual product listings for ingredients.","ar":"انظر تفاصيل كل منتج داخل العلبة."},"storage":{"fr":"À conserver dans un endroit frais et sec.","en":"Store in a cool, dry place.","ar":"يُحفظ في مكان بارد وجاف."},"allergens":["gluten","lait","œufs"],"weight":"[Coffret 4 pièces]","price":0,"currency":"DZD","image":"/images/produits/braj-coffret-vert.jpg","badges":[],"inStock":true,"featured":false}],"initialCategory":"biscuits"}],["$","div",null,{"className":"mt-16 bg-suzanne-vertVif/10 border border-suzanne-vertVif/20 rounded-brand p-6 sm:p-8 flex flex-col sm:flex-row items-center justify-between gap-6","children":[["$","div",null,{"className":"flex items-center gap-4","children":[["$","div",null,{"className":"p-3 bg-suzanne text-suzanne-creme rounded-full","children":["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-gift w-6 h-6 text-suzanne-vertVif","children":[["$","rect","bkv52",{"x":"3","y":"8","width":"18","height":"4","rx":"1"}],["$","path","1c76mn",{"d":"M12 8v13"}],["$","path","6wjy6b",{"d":"M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7"}],["$","path","1ihvrl",{"d":"M7.5 8a2.5 2.5 0 0 1 0-5A4.8 8 0 0 1 12 8a4.8 8 0 0 1 4.5-5 2.5 2.5 0 0 1 0 5"}],"$undefined"]}]}],["$","div",null,{"children":[["$","h3",null,{"className":"text-base sm:text-lg font-bold text-suzanne font-serif","children":"Food gift boxes"}],["$","p",null,{"className":"text-xs sm:text-sm text-suzanne/75","children":"Choose 3 to 6 products, we assemble the box for you."}]]}]]}],"$Lc"]}]]}]]}]
8:["$","$Ld",null,{"locale":"en","now":"$D2026-10-01T14:41:58.346Z","timeZone":"Europe/Paris","messages":{"common":{"topBanner":"Delivery in Oran within [24–48 h] · Free pickup at the shop","byCheffe":"by the Cheffe","giftBoxesBadge":"Gift boxes","price":"Price","priceUpcoming":"Price to be announced","fullAddress":"Hai Abdelkader, Traversa, Oran 31002, Algeria","badges":{"Fait maison":"Homemade","Sans conservateur":"Preservative-free"},"ranges":{"confitures":"Jams","biscuits":"Biscuits","chlita":"Chlita","braj":"Braj","torchi":"Torchi","coffrets":"Gift boxes"},"alts":{"hero":"Inside the Cheffe Suzanne fine food shop in Oran, bread and olive oil on the counter","cheffe":"Portrait of Cheffe Suzanne in her kitchen in Oran","giftBox":"Cheffe Suzanne gourmet gift box in green packaging","shopFacade":"Shopfront of the Cheffe Suzanne fine food store in Oran","atelier1":"Careful plating in the Cheffe Suzanne kitchen","atelier2":"Cheffe's hands at work on a wooden board","atelier3":"Selection of natural spices and herbs","atelier4":"Bottles and fine condiments by Cheffe Suzanne","atelier5":"Artisan breads, preserves and jars in Oran","confitures":"Artisan jams in jars with toast and spoon","biscuits":"Homemade biscuits, shortbread and sweets","chlita":"Traditional chlita and breads baked in the kitchen","braj":"Date braj cut into diamonds in its green box","torchi":"Jars of pickled crunchy vegetables in vinegar"},"nav":{"home":"Home","products":"Our products","boxes":"Gift boxes","story":"Our story","shop":"The shop","contact":"Contact","cart":"Cart"},"buttons":{"addToCart":"Add to cart","viewProduct":"View product","orderWhatsApp":"Order on WhatsApp","buildBox":"Build a gift box","visitUs":"Visit us","directions":"Get directions","readStory":"Read our story","seeBoxes":"See our gift boxes","discoverProducts":"See our products","viewAllProducts":"View all","callShop":"Call the shop","send":"Send","notifyMe":"Notify me","requestQuote":"Request a quote","backHome":"Back to home"},"footer":{"tagline":"« Authentic flavours, handcrafted passion. »","brandDesc":"Cheffe Suzanne, a fine food shop and kitchen in Oran.","subDesc":"Jams, biscuits, chlita, braj and torchi made in small batches.","address":"Hai Abdelkader, Traversa, Oran","phone":"+213 552 58 20 47","email":"shop@cheffesuzanne.com","hoursLabel":"Hours:","hours":"[Saturday to Thursday, 9am – 7pm]","infoLabel":"Information","socialLabel":"Social:","deliveryLink":"Delivery and pickup","faqLink":"FAQ","legalLink":"Legal notice","copyright":"© 2026 Cheffe Suzanne"},"newsletter":{"title":"One letter a month, no more.","text":"New seasonal jams, braj baking days and the occasional recipe.","placeholder":"Your email","button":"Sign up","success":"Done. The next letter arrives at the start of the month."}},"home":{"hero":{"eyebrow":"« Authentic flavours, handcrafted passion. »","title":"Fine food and homemade preserves in Oran","subtitle":"Seasonal fruit jams, biscuits, chlita, braj and torchi, made in our kitchen in small batches."},"univers":{"title":"What we make","jamsTitle":"Artisan jams","jamsDesc":"Seasonal fruit, sugar, and the time it takes. Nothing else.","biscuitsTitle":"Homemade biscuits","biscuitsDesc":"Butter shortbreads and small cakes, for coffee or for guests.","chlitaTitle":"Traditional chlita","chlitaDesc":"[Short description to be provided by the brand.]","brajTitle":"Braj","brajDesc":"A semolina flatbread filled with date paste, cooked the way it's done at home.","torchiTitle":"Torchi (homemade pickles)","torchiDesc":"Crunchy vegetables pickled in vinegar, jarred by hand."},"cheffe":{"title":"Behind every jar, there's a kitchen","textP1":"Cheffe Suzanne started as a family kitchen. The recipes come from [my mother / my grandmother] and have barely changed: we pick the fruit at the market, cook it, fill the jars and label them by hand.","textP2":"Today that kitchen is a small workshop and shop in Oran. We sell what we make, plus a few products from growers we know.","signature":"Suzanne"},"bestSellers":{"title":"Most requested","subtitle":"What our customers come back for."},"values":{"title":"How we work","val1Title":"Ingredients you can name","val1Desc":"Fruit, sugar, semolina, dates, butter, vinegar, spices. No preservatives, no added flavourings.","val2Title":"Small batches","val2Desc":"We cook [a few dozen] jars at a time. The production date is written on every label.","val3Title":"Local suppliers","val3Desc":"We buy our fruit and vegetables from growers around Oran whenever the season allows."},"giftBox":{"title":"A gift meant for sharing","text":"For Eid, a new baby, a thank-you or a corporate gift. Pick a ready-made box or build your own. We take care of the paper and ribbon."},"atelier":{"title":"In the kitchen this week","subtitle":"What's cooking, drying and coming out of the oven. Follow us on Instagram."},"reviews":{"title":"In our customers' words"},"visit":{"title":"Come by the shop","text":"You can taste before you buy. If you need a gift, we'll put a box together for you on the spot.","address":"Hai Abdelkader, Traversa, Oran · [Hours]","hoursLabel":"Hours:","hours":"[Saturday to Thursday: 9am – 7pm · Friday: closed]"}},"cart":{"title":"Your Cart","empty":"Your cart is empty. Have a look at our seasonal jams.","subtotal":"Subtotal","shipping":"Delivery","shippingNote":"calculated at next step","total":"Total","deliveryMode":"Receiving method:","pickupOption":"Pickup at the shop (free)","deliveryOption":"Home delivery","whatsappButton":"Send my order on WhatsApp","emailButton":"Send via email","formName":"Full name","formPhone":"Phone number","formAddress":"Delivery address (if delivery)","formNotes":"Notes or gift message (optional)","orderSuccess":"Thank you! Your order has been sent on WhatsApp. We'll confirm availability and the pickup or delivery time.","soldOut":"Sold out for now","priceUpcoming":"Price to be announced","close":"Close","quantity":"Quantity","checkout":"Checkout","itemAdded":"Product added to cart"},"products":{"h1":"Our homemade products","intro":"Everything here is made in our kitchen in Oran, in small batches. Stock follows the seasons. If something is sold out, message us and we'll let you know when it's back.","filterAll":"All","filterConfitures":"Jams","filterBiscuits":"Biscuits","filterChlita":"Chlita","filterBraj":"Braj","filterTorchi":"Torchi","filterCoffrets":"Gift boxes","sortBy":"Sort by","sortDefault":"Default","sortPriceAsc":"Price: low to high","sortPriceDesc":"Price: high to low","soldOut":"Sold out for now","notifyMe":"Notify me","noProducts":"No products found matching your criteria.","categoryIntros":{"confitures":{"title":"Artisan jams","text":"Our jams follow the seasons: figs at the end of summer, bitter oranges in winter, apricots in spring. We cook them in small pans to keep the taste of the fruit and a texture that stays on the bread. No preservatives or colourings."},"biscuits":{"title":"Homemade biscuits","text":"Simple, golden butter recipes. They keep for [two to three weeks] in their tin."},"chlita":{"title":"Traditional chlita","text":"[Text to be provided by the brand.]"},"braj":{"title":"Braj","text":"Braj is a semolina flatbread filled with date paste and cooked in a pan or on a tadjine. We make it the home way: semolina, butter, dates, a pinch of spice. We make it all year, and a little more when spring comes."},"torchi":{"title":"Torchi (homemade pickles)","text":"Carrots, turnips, chillies, lemons: crunchy vegetables kept in spiced vinegar. Torchi goes with stews, sandwiches and grilled meat."},"coffrets":{"title":"Gift boxes","text":"Our boxes are put together by hand in our green box, with tissue paper and a ribbon. Add a short note and we'll write it for you."}}},"productDetail":{"tabs":{"description":"Description","ingredients":"Ingredients","storage":"Storage"},"allergensTitle":"Contains (allergens):","allergensWarning":"Contains:","relatedTitle":"You might also like","breadcrumbs":{"home":"Home","products":"Our products"},"weight":"Weight:","quantity":"Quantity","addToCart":"Add to cart","priceUpcoming":"Price to be announced","inStock":"In stock","outOfStock":"Sold out for now","notifyWhatsApp":"Notify me on WhatsApp"},"boxesPage":{"h1":"Food gift boxes","intro":"Our boxes are put together by hand in our green box, with tissue paper and a ribbon. Add a short note and we'll write it for you.","readyMadeTitle":"Our ready-made boxes","customBoxTitle":"Build my box","customBoxSubtitle":"Choose 3 to 6 products, we assemble the box for you.","selectedCount":"{count} / 6 products selected (minimum 3)","addCustomBoxToCart":"Add custom box to cart","minProductsWarning":"Please select at least 3 products to build your box.","maxProductsWarning":"You can select up to 6 products.","corporateTitle":"For your clients, teams and guests","corporateText":"Weddings, engagements, Eid, end of year: we make boxes in quantity, with a card in your name. Allow [10 days] for more than 20 boxes.","corporateButton":"Request a quote on WhatsApp"},"storyPage":{"h1":"Our story","p1":"It all started in a family kitchen in Oran. [My mother] made her jams every summer, braj when spring came, and torchi in big jars kept on the balcony. I watched her for years before I dared touch the pot.","p2":"In [year], I started selling a few jars to neighbours, then to friends of friends. The orders grew and the kitchen became too small. In [year], Cheffe Suzanne opened its shop, with a kitchen right behind it.","p3":"We still work the same way: we buy what's in season, cook in small quantities, and never put anything in a jar that we wouldn't serve at our own table. Next to our own preserves you'll also find products from growers we know personally: oils, honeys, spices.","p4":"If you come by the shop, something is often cooking. Feel free to ask for a taste.","signature":"Suzanne","stats":"[X] recipes · [X] jars a week · [X] partner growers"},"shopPage":{"h1":"Our fine food shop in Oran","text":"The shop is in Hai Abdelkader, Traversa. You'll find all our preserves, selected fine food products and gift boxes ready to give. We take the time to let you taste and to help you choose.","addressTitle":"Address","address":"Hai Abdelkader, Traversa, Oran 31002","hoursTitle":"Hours","hours":"[Saturday – Thursday: 9am – 7pm · Friday: closed]","accessTitle":"Access & landmarks","access":"[Nearby landmark, parking…]","directions":"Get directions","call":"Call the shop"},"contactPage":{"h1":"Contact and orders","text":"A question about a product, an order for an event, an allergy? Write or call us, we reply [the same day].","formName":"Name","formPhone":"Phone","formEmail":"Email (optional)","formMessage":"Your message","formSubmit":"Send","formSuccess":"Thank you, your message has arrived. We'll reply [the same day].","whatsappTitle":"Fastest:","whatsappText":"Message us on WhatsApp at +213 552 58 20 47."},"deliveryPage":{"h1":"Delivery and pickup","pickupTitle":"Pickup at the shop","pickupText":"Free. Ready [within 2 hours] during opening hours.","oranTitle":"Delivery in Oran","oranText":"[— DZD], within [24–48 h].","wilayasTitle":"Other wilayas","wilayasText":"[to confirm].","paymentTitle":"Payment","paymentText":"Cash on delivery or at the shop [or by card].","freshTitle":"Fresh products","freshText":"Braj keeps a few days, so we make it to order and deliver it in Oran only."},"faqPage":{"h1":"FAQ","items":[{"q":"Do your jams contain preservatives?","a":"No. They contain fruit, sugar and sometimes lemon juice. Sugar and cooking are enough to preserve them."},{"q":"How long does an opened jar of jam keep?","a":"About three weeks in the fridge, using a clean spoon each time."},{"q":"How long does braj keep?","a":"[5 days] at room temperature, well wrapped. It also freezes well and can be warmed in a pan."},{"q":"Do you deliver outside Oran?","a":"[to confirm]"},{"q":"Can I order for a wedding or an event?","a":"Yes. Contact us at least [10 days] ahead for large quantities."},{"q":"Are your products halal?","a":"[to confirm]"},{"q":"Allergens?","a":"Our biscuits and braj contain gluten and milk. Some biscuits contain eggs and nuts. Everything is listed on each product page and label."}]},"legalNoticePage":{"h1":"Legal notice","text":"[To be drafted with company legal info.]"},"journalPage":{"h1":"The Cheffe's Journal","emptyState":"Our first kitchen journal articles are coming very soon. Family recipes, workshop stories, and preservation tips."}},"children":["$","$Le",null,{"children":["$Lf",["$","$L10",null,{}],["$","main",null,{"className":"flex-1","children":["$","$L3",null,{"parallelRouterKey":"children","segmentPath":["children","$4","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L5",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":["$","$L11",null,{}],"notFoundStyles":[]}]}],"$L12",["$","$L13",null,{}]]}]}]
