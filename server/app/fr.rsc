5:["$","section",null,{"className":"py-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto","children":[["$","div",null,{"className":"flex flex-col sm:flex-row sm:items-end justify-between mb-12 gap-4","children":[["$","div",null,{"children":[["$","h2",null,{"className":"text-3xl sm:text-4xl font-bold text-suzanne tracking-tight","children":"Ce que nos clients reprennent"}],["$","p",null,{"className":"text-sm text-suzanne/70 mt-1","children":"Les produits qui partent le plus vite à la boutique."}]]}],"$L19"]}],["$","div",null,{"className":"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6","children":[["$","$L1a","confiture-de-figues",{"product":{"id":"confiture-de-figues","slug":{"fr":"confiture-de-figues","en":"fig-jam"},"name":{"fr":"Confiture de figues","en":"Fig jam","ar":"مربى التين"},"range":"confitures","shortDescription":{"fr":"Des figues mûres cuites doucement, avec une pointe de citron.","en":"Ripe figs cooked slowly with a little lemon.","ar":"تين ناضج مطهو على نار هادئة مع قليل من الليمون."},"description":{"fr":"On attend que les figues soient bien mûres avant de les cuire, pour qu'elles donnent leur sucre naturel. Le résultat est une confiture épaisse, avec des morceaux, qui va aussi bien sur le pain que sur un fromage.","en":"We wait for the figs to be fully ripe so they bring their own sweetness. Thick, with pieces of fruit, good on bread or with cheese.","ar":"ننتظر أن ينضج التين تمامًا ليمنح حلاوته الطبيعية. مربى كثيف بقطع الفاكهة، يناسب الخبز والجبن."},"ingredients":{"fr":"Figues, sucre, jus de citron. [à confirmer]","en":"Figs, sugar, lemon juice. [to confirm]","ar":"تين، سكر، عصير ليمون. [يُؤكد لاحقًا]"},"storage":{"fr":"Avant ouverture, à l'abri de la lumière. Après ouverture, au réfrigérateur, à consommer sous 3 semaines.","en":"Before opening, keep away from light. After opening, refrigerate and eat within 3 weeks.","ar":"قبل الفتح، بعيدًا عن الضوء. بعد الفتح، في الثلاجة ويُستهلك خلال 3 أسابيع."},"allergens":[],"weight":"[250 g]","price":0,"currency":"DZD","image":"/images/bannieres/banniere-confitures.jpg","badges":["Sans conservateur"],"inStock":true,"featured":true}}],["$","$L1a","sables-au-beurre",{"product":{"id":"sables-au-beurre","slug":{"fr":"sables-au-beurre","en":"butter-shortbread"},"name":{"fr":"Sablés au beurre","en":"Butter shortbread","ar":"بسكويت بالزبدة"},"range":"biscuits","shortDescription":{"fr":"Le sablé tout simple, au beurre, bien doré.","en":"Plain, buttery and golden.","ar":"بسيط، بالزبدة، ومذهّب."},"description":{"fr":"Une pâte au beurre, un peu de sucre, une cuisson lente. C'est le biscuit qu'on sert avec le café à la boutique.","en":"The biscuit we serve with coffee at the shop.","ar":"البسكويت الذي نقدّمه مع القهوة في المحل."},"ingredients":{"fr":"Farine, beurre, sucre, œufs, sel. Contient : gluten, lait, œufs.","en":"Flour, butter, sugar, eggs, salt. Contains: gluten, milk, eggs.","ar":"فرينة، زبدة، سكر، بيض، ملح. يحتوي على: غلوتين، حليب، بيض."},"storage":{"fr":"Dans sa boîte fermée, [3 semaines].","en":"In its sealed tin, [3 weeks].","ar":"في علبته المغلقة، [3 أسابيع]."},"allergens":["gluten","lait","œufs"],"weight":"[200 g]","price":0,"currency":"DZD","image":"/images/produits/confitures-biscuits.jpg","badges":["Fait maison"],"inStock":true,"featured":true}}],["$","$L1a","braj-aux-dattes",{"product":{"id":"braj-aux-dattes","slug":{"fr":"braj-aux-dattes","en":"date-braj"},"name":{"fr":"Braj aux dattes","en":"Date braj","ar":"براج بالتمر"},"range":"braj","shortDescription":{"fr":"Galette de semoule fourrée à la pâte de dattes.","en":"Semolina flatbread filled with date paste.","ar":"رقاقة سميد محشوة بعجينة التمر."},"description":{"fr":"Une pâte de semoule au beurre, une couche épaisse de dattes, une cuisson lente jusqu'à ce que les bords dorent. Se coupe en losanges et se partage au goûter, avec un lait ou un thé.","en":"Butter semolina dough, a thick layer of dates, slow-cooked until the edges turn golden. Cut into diamonds and shared at teatime.","ar":"عجينة سميد بالزبدة، طبقة سميكة من التمر، وطهي هادئ حتى تذهب الحواف. يُقطّع معيّنات ويُقتسم في وقت القهوة."},"ingredients":{"fr":"Semoule de blé, pâte de dattes, beurre, sel, [épices]. Contient : gluten, lait.","en":"Wheat semolina, date paste, butter, salt, [spices]. Contains: gluten, milk.","ar":"سميد قمح، عجينة تمر، زبدة، ملح، [توابل]. يحتوي على: غلوتين، حليب."},"storage":{"fr":"[5 jours] à température ambiante, dans un linge ou une boîte.","en":"[5 days] at room temperature, well wrapped.","ar":"[5 أيام] في درجة حرارة الغرفة، ملفوفًا جيدًا."},"allergens":["gluten","lait"],"weight":"[—]","price":0,"currency":"DZD","image":"/images/produits/braj-coffret-vert.jpg","badges":["Fait maison"],"inStock":true,"featured":true}}],["$","$L1a","torchi-de-legumes",{"product":{"id":"torchi-de-legumes","slug":{"fr":"torchi-de-legumes","en":"vegetable-torchi"},"name":{"fr":"Torchi de légumes","en":"Vegetable torchi","ar":"طرشي الخضر"},"range":"torchi","shortDescription":{"fr":"Carottes, navets et piments au vinaigre, bien croquants.","en":"Carrots, turnips and chillies in vinegar, nice and crunchy.","ar":"جزر ولفت وفلفل في الخل، مقرمش."},"description":{"fr":"Des légumes coupés à la main et conservés dans un vinaigre aux épices. Comptez [une semaine] de repos avant qu'ils prennent tout leur goût : on les met en vente quand ils sont prêts.","en":"Hand-cut vegetables in spiced vinegar. They rest for [a week] before they're ready to sell.","ar":"خضر مقطعة باليد في خل متبّل، تُترك [أسبوعًا] قبل أن تصبح جاهزة للبيع."},"ingredients":{"fr":"Carottes, navets, piments, vinaigre, eau, sel, ail, épices. [à confirmer]","en":"Carrots, turnips, chillies, vinegar, water, salt, garlic, spices. [to confirm]","ar":"جزر، لفت، فلفل حار، خل، ماء، ملح، ثوم، توابل. [يُؤكد لاحقًا]"},"storage":{"fr":"Au réfrigérateur après ouverture, légumes toujours couverts de liquide.","en":"Refrigerate after opening, vegetables always kept under brine.","ar":"في الثلاجة بعد الفتح، الخضر مغطاة دائمًا بالسائل."},"allergens":[],"weight":"[500 g]","price":0,"currency":"DZD","image":"/images/bannieres/banniere-pickles.jpg","badges":["Fait maison","Sans conservateur"],"inStock":true,"featured":true}}]]}]]}]
